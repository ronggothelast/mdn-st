---
// STYLE 01 — Editorial Magazine
import ProfileLayout from '../../layouts/ProfileLayout.astro';
import { brand, profile, services, team, stages, impactCards, kicker } from '../../data/content';
const base = import.meta.env.BASE_URL;
---
<ProfileLayout styleNum={1} styleName="Editorial Magazine">
  <article class="font-serif" style="background: #FDFCF8; color: #1A2E4A;">
    <!-- Cover -->
    <header class="min-h-screen flex flex-col justify-center py-32 border-b border-[#1A2E4A]">
      <div class="container-x max-w-5xl">
        <div class="text-xs font-sans uppercase tracking-[0.4em] text-[#3D8F8A] mb-8">Company Profile · 2026</div>
        <h1 class="text-[clamp(3.5rem,9vw,8rem)] leading-[0.95] font-medium mb-12">{brand.name}</h1>
        <p class="text-2xl italic text-[#5C6B7E] max-w-2xl mb-8">
          <span data-lang="en">{brand.tagline.en}</span><span data-lang="id">{brand.tagline.id}</span>
        </p>
        <div class="mt-16 pt-8 border-t border-[#E2E6EC] text-sm font-sans flex justify-between">
          <div class="uppercase tracking-wider text-[#5C6B7E]"><span data-lang="en">A strategic impact consultancy</span><span data-lang="id">Konsultan dampak strategis</span></div>
          <div class="text-right">{brand.web}</div>
        </div>
      </div>
    </header>

    <!-- Part I: Identity -->
    <section class="py-32 border-b border-[#E2E6EC]">
      <div class="container-x max-w-4xl">
        <div class="text-xs font-sans uppercase tracking-[0.3em] text-[#3D8F8A] mb-8">Part I</div>
        
        <h2 class="text-5xl mb-8"><span data-lang="en">{profile.whoWeAre.title.en}</span><span data-lang="id">{profile.whoWeAre.title.id}</span></h2>
        {profile.whoWeAre.body.en.map((p, i) => (
          <p class={`text-xl leading-[1.7] mb-8 ${i === 0 ? 'dropcap' : ''}`}>
            <span data-lang="en">{p}</span><span data-lang="id">{profile.whoWeAre.body.id[i]}</span>
          </p>
        ))}

        <div class="my-24"></div>

        <h2 class="text-4xl mb-8"><span data-lang="en">{profile.whoWeServe.title.en}</span><span data-lang="id">{profile.whoWeServe.title.id}</span></h2>
        <p class="text-xl leading-[1.7] text-[#5C6B7E]">
          <span data-lang="en">{profile.whoWeServe.body.en}</span><span data-lang="id">{profile.whoWeServe.body.id}</span>
        </p>
      </div>
    </section>

    <!-- Part II: The Gap & Approach -->
    <section class="py-32 border-b border-[#E2E6EC]">
      <div class="container-x max-w-4xl">
        <div class="text-xs font-sans uppercase tracking-[0.3em] text-[#3D8F8A] mb-8">Part II</div>
        
        <h2 class="text-5xl mb-8"><span data-lang="en">{profile.theGap.title.en}</span><span data-lang="id">{profile.theGap.title.id}</span></h2>
        {profile.theGap.body.en.map((p, i) => (
          <p class="text-xl leading-[1.7] mb-8 text-[#5C6B7E]">
            <span data-lang="en">{p}</span><span data-lang="id">{profile.theGap.body.id[i]}</span>
          </p>
        ))}

        <div class="my-24 text-center">
          <p class="text-3xl md:text-5xl leading-tight italic max-w-3xl mx-auto">
            <span data-lang="en" set:html={kicker.approachTitle.en}></span>
            <span data-lang="id" set:html={kicker.approachTitle.id}></span>
          </p>
        </div>

        <h3 class="text-3xl mb-12"><span data-lang="en">Our Approach</span><span data-lang="id">Pendekatan Kami</span></h3>
        <div class="space-y-12">
          {stages.map(s => (
            <div class="flex gap-8">
              <div class="text-4xl text-[#3D8F8A]">0{s.num}</div>
              <div>
                <h4 class="text-2xl mb-3"><span data-lang="en">{s.title.en}</span><span data-lang="id">{s.title.id}</span></h4>
                <p class="text-lg leading-[1.6] text-[#5C6B7E]">
                  <span data-lang="en">{s.body.en}</span><span data-lang="id">{s.body.id}</span>
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Part III: Services -->
    <section class="py-32 border-b border-[#E2E6EC]">
      <div class="container-x max-w-5xl">
        <div class="text-xs font-sans uppercase tracking-[0.3em] text-[#3D8F8A] mb-8">Part III</div>
        <h2 class="text-5xl mb-16"><span data-lang="en">Three Services</span><span data-lang="id">Tiga Layanan</span></h2>
        
        {services.map((svc, i) => (
          <div class={`grid lg:grid-cols-[1fr_2fr] gap-10 py-16 ${i < services.length - 1 ? 'border-b border-[#E2E6EC]' : ''}`}>
            <div>
              <div class="text-7xl font-medium text-[#3D8F8A] mb-4">{svc.num}</div>
              <h3 class="text-3xl mb-4 leading-tight"><span data-lang="en">{svc.title.en}</span><span data-lang="id">{svc.title.id}</span></h3>
            </div>
            <div>
              {svc.detail.en.map((p, j) => (
                <p class="text-xl leading-[1.7] text-[#5C6B7E] mb-6">
                  <span data-lang="en">{p}</span><span data-lang="id">{svc.detail.id[j]}</span>
                </p>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Part IV: Proof -->
    <section class="py-32 border-b border-[#E2E6EC]" style="background: #1A2E4A; color: white;">
      <div class="container-x max-w-5xl">
        <div class="text-xs font-sans uppercase tracking-[0.3em] text-[#5BAFA9] mb-8">Part IV</div>
        <h2 class="text-5xl mb-16"><span data-lang="en">Proof of Execution</span><span data-lang="id">Bukti Eksekusi</span></h2>
        
        <div class="grid md:grid-cols-2 gap-12">
          {impactCards.map(c => (
            <div class="border-t border-[#3D8F8A] pt-6">
              <div class="font-sans text-xs uppercase tracking-widest text-[#5BAFA9] mb-4"><span data-lang="en">{c.tag.en}</span><span data-lang="id">{c.tag.id}</span></div>
              <h3 class="text-2xl mb-4"><span data-lang="en">{c.title.en}</span><span data-lang="id">{c.title.id}</span></h3>
              <p class="text-lg leading-[1.6] text-white/70"><span data-lang="en">{c.body.en}</span><span data-lang="id">{c.body.id}</span></p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Part V: Team -->
    <section class="py-32 border-b border-[#E2E6EC]">
      <div class="container-x max-w-5xl">
        <div class="text-xs font-sans uppercase tracking-[0.3em] text-[#3D8F8A] mb-8">Part V</div>
        <h2 class="text-5xl mb-16"><span data-lang="en">The Team</span><span data-lang="id">Tim Kami</span></h2>
        
        <div class="space-y-16">
          {team.map(m => (
            <div class="grid md:grid-cols-[1fr_2fr] gap-8">
              <div>
                <h3 class="text-3xl mb-2">{m.name}</h3>
                <div class="font-sans text-xs uppercase tracking-wider text-[#3D8F8A]"><span data-lang="en">{m.role.en}</span><span data-lang="id">{m.role.id}</span></div>
              </div>
              <p class="text-xl leading-[1.7] text-[#5C6B7E]">
                <span data-lang="en">{m.bioFull.en}</span><span data-lang="id">{m.bioFull.id}</span>
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Part VI: Closing -->
    <footer class="py-40 text-center">
      <div class="container-x max-w-3xl">
        <h2 class="text-5xl mb-12"><span data-lang="en">{profile.whatComesNext.title.en}</span><span data-lang="id">{profile.whatComesNext.title.id}</span></h2>
        {profile.whatComesNext.body.en.map((p, i) => (
          <p class="text-xl leading-relaxed mb-6 text-[#5C6B7E]">
            <span data-lang="en">{p}</span><span data-lang="id">{profile.whatComesNext.body.id[i]}</span>
          </p>
        ))}
        <div class="mt-20 pt-12 border-t border-[#E2E6EC] font-sans">
          <div class="text-2xl font-serif italic mb-2">{brand.name}</div>
          <div class="text-sm text-[#5C6B7E]">{brand.email} · {brand.phone}</div>
        </div>
      </div>
    </footer>
  </article>
</ProfileLayout>