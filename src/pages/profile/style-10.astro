---
// STYLE 10 — Madani Heritage (warmth maxed)
import ProfileLayout from '../../layouts/ProfileLayout.astro';
import { brand, profile, services, team } from '../../data/content';
const base = import.meta.env.BASE_URL;
---
<ProfileLayout styleNum={10} styleName="Madani Heritage">
  <div style="background: #FAF6EC; color: #1A2E4A; font-family: 'Fraunces', Georgia, serif;">
    <!-- Heritage hero with leaf motif -->
    <section class="py-32 relative overflow-hidden" style="background: linear-gradient(180deg, #F4ECDB 0%, #FAF6EC 100%);">
      <div class="absolute -top-20 -right-20 w-96 h-96 rounded-full opacity-30" style="background: radial-gradient(circle at 30% 30%, #5BAFA9, #3D8F8A 60%, #1A2E4A);"></div>
      <div class="absolute -bottom-32 -left-32 w-[500px] h-[500px] rounded-full opacity-20" style="background: radial-gradient(circle, #C9A876, transparent 70%);"></div>

      <div class="container-x relative max-w-5xl">
        <div class="flex items-center gap-3 mb-12">
          <div class="relative w-16 h-16 rounded-full overflow-hidden">
            <div class="absolute inset-0" style="background: radial-gradient(circle at 30% 30%, #5BAFA9, #3D8F8A 60%, #1A2E4A);"></div>
            <div class="absolute inset-3 rounded-full opacity-70" style="background: linear-gradient(135deg, transparent 40%, #C9A876 40%, #F4ECDB 60%, transparent 60%);"></div>
          </div>
          <div class="font-sans text-xs uppercase tracking-[0.3em]" style="color: #3D8F8A;">Est. 2026 · Indonesia</div>
        </div>

        <h1 class="text-[clamp(4rem,10vw,9rem)] font-medium leading-[0.95] tracking-tight mb-8">{brand.name}</h1>
        <p class="text-3xl italic max-w-2xl" style="color: #3D8F8A;">
          <span data-lang="en">{brand.tagline.en}</span>
          <span data-lang="id">{brand.tagline.id}</span>
        </p>
      </div>
    </section>

    <section class="py-24">
      <div class="container-x grid lg:grid-cols-2 gap-16 items-start">
        <div class="rounded-3xl overflow-hidden aspect-[4/5]">
          <img src={base + '/assets/images/hero-community.png'} alt="Community" class="w-full h-full object-cover" />
        </div>
        <div>
          <div class="font-sans text-xs uppercase tracking-[0.3em] mb-4" style="color: #C9A876;">Our story</div>
          <h2 class="text-5xl mb-8">
            <span data-lang="en">{profile.whoWeAre.title.en}</span>
            <span data-lang="id">{profile.whoWeAre.title.id}</span>
          </h2>
          {profile.whoWeAre.body.en.map((p, i) => (
            <p class={`text-lg leading-[1.7] mb-6 ${i === 0 ? 'dropcap' : ''}`}>
              <span data-lang="en">{p}</span>
              <span data-lang="id">{profile.whoWeAre.body.id[i]}</span>
            </p>
          ))}
        </div>
      </div>
    </section>

    <section class="py-24" style="background: #1A2E4A; color: white;">
      <div class="container-x">
        <div class="font-sans text-xs uppercase tracking-[0.3em] mb-4 text-center" style="color: #5BAFA9;">Our practices</div>
        <h2 class="text-5xl text-center mb-16">
          <span data-lang="en">Three pillars of work</span>
          <span data-lang="id">Tiga pilar kerja</span>
        </h2>
        <div class="grid md:grid-cols-3 gap-8">
          {services.map(svc => (
            <div class="p-8 rounded-2xl border border-white/10" style="background: rgba(255,255,255,0.03);">
              <div class="w-14 h-14 rounded-full mb-6 flex items-center justify-center font-medium text-xl" style="background: #3D8F8A;">{svc.num}</div>
              <h3 class="text-2xl mb-4">
                <span data-lang="en">{svc.title.en}</span>
                <span data-lang="id">{svc.title.id}</span>
              </h3>
              <p class="text-white/75 leading-relaxed">
                <span data-lang="en">{svc.short.en}</span>
                <span data-lang="id">{svc.short.id}</span>
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-24">
      <div class="container-x max-w-4xl text-center">
        <div class="font-sans text-xs uppercase tracking-[0.3em] mb-4" style="color: #C9A876;">Belief</div>
        <p class="text-5xl italic leading-tight" style="color: #1A2E4A;">
          <span class="text-7xl align-top mr-2" style="color: #3D8F8A;">"</span>
          <span data-lang="en">Strategy without execution is theory. Execution without measurement is guesswork.</span>
          <span data-lang="id">Strategi tanpa eksekusi hanya teori. Eksekusi tanpa pengukuran hanya tebakan.</span>
        </p>
      </div>
    </section>

    <section class="py-24">
      <div class="container-x">
        <div class="font-sans text-xs uppercase tracking-[0.3em] mb-4 text-center" style="color: #C9A876;">Our team</div>
        <h2 class="text-5xl text-center mb-16">
          <span data-lang="en">Practitioners, not analysts</span>
          <span data-lang="id">Praktisi, bukan analis</span>
        </h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          {team.map(m => (
            <div class="text-center">
              <div class="aspect-square rounded-3xl mb-5 relative overflow-hidden" style="background: linear-gradient(135deg, #3D8F8A, #1A2E4A);">
                <div class="absolute inset-0" style="background: radial-gradient(circle at 50% 30%, rgba(201,168,118,0.3), transparent 60%);"></div>
                <div class="absolute inset-0 flex items-center justify-center text-white text-5xl font-medium opacity-90">{m.initials}</div>
              </div>
              <h3 class="text-xl mb-1">{m.name}</h3>
              <div class="text-xs font-sans uppercase tracking-wider mb-3" style="color: #3D8F8A;">
                <span data-lang="en">{m.role.en}</span>
                <span data-lang="id">{m.role.id}</span>
              </div>
              <p class="text-sm leading-relaxed text-[#5C6B7E]">
                <span data-lang="en">{m.bioShort.en}</span>
                <span data-lang="id">{m.bioShort.id}</span>
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-24 text-center" style="background: linear-gradient(180deg, #FAF6EC 0%, #F4ECDB 100%);">
      <div class="container-x max-w-3xl">
        <h2 class="text-5xl mb-8">
          <span data-lang="en">{profile.whatComesNext.title.en}</span>
          <span data-lang="id">{profile.whatComesNext.title.id}</span>
        </h2>
        {profile.whatComesNext.body.en.map((p, i) => (
          <p class="text-lg leading-[1.7] mb-4" style="color: #5C6B7E;">
            <span data-lang="en">{p}</span>
            <span data-lang="id">{profile.whatComesNext.body.id[i]}</span>
          </p>
        ))}
        <a href={`mailto:${brand.email}`} class="inline-block mt-8 px-10 py-4 rounded-full font-medium font-sans" style="background: #1A2E4A; color: white;">{brand.email}</a>
      </div>
    </section>
  </div>
</ProfileLayout>
