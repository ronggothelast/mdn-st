---
// STYLE 05 — Sustainability Brief
// Impact-focused. Teal-led. Infographic touches. Like a Foundation report.
import ProfileLayout from '../../layouts/ProfileLayout.astro';
import { brand, profile, services, team, stages, impactCards, kicker } from '../../data/content';
const base = import.meta.env.BASE_URL;
---
<ProfileLayout styleNum={5} styleName="Sustainability Brief">
  <div style="background: #FFFFFF; color: #1A2E4A; font-family: 'Inter', sans-serif;">
    <!-- Hero -->
    <section class="py-24" style="background: linear-gradient(135deg, #3D8F8A 0%, #1A2E4A 100%); color: white;">
      <div class="container-x max-w-6xl">
        <div class="grid md:grid-cols-12 gap-12 items-end">
          <div class="md:col-span-7">
            <div class="text-xs uppercase tracking-[0.3em] mb-8 font-medium" style="color: #C9A876;">
              <span data-lang="en">Strategic Impact Brief · 2026</span>
              <span data-lang="id">Brief Dampak Strategis · 2026</span>
            </div>
            <h1 class="text-[clamp(3rem,7vw,6rem)] font-medium leading-[1.05] tracking-tight mb-8" style="font-family: 'Fraunces', Georgia, serif;">{brand.name}</h1>
            <p class="text-2xl leading-snug max-w-xl" style="color: rgba(255,255,255,0.85);">
              <span data-lang="en">{brand.tagline.en}</span>
              <span data-lang="id">{brand.tagline.id}</span>
            </p>
          </div>
          <div class="md:col-span-5 grid grid-cols-2 gap-4">
            <div class="p-6 rounded-2xl backdrop-blur" style="background: rgba(255,255,255,0.08);">
              <div class="text-4xl font-medium mb-2" style="font-family: 'Fraunces', Georgia, serif; color: #5BAFA9;">3</div>
              <div class="text-xs uppercase tracking-wider"><span data-lang="en">Service Lines</span><span data-lang="id">Layanan</span></div>
            </div>
            <div class="p-6 rounded-2xl backdrop-blur" style="background: rgba(255,255,255,0.08);">
              <div class="text-4xl font-medium mb-2" style="font-family: 'Fraunces', Georgia, serif; color: #5BAFA9;">20+</div>
              <div class="text-xs uppercase tracking-wider"><span data-lang="en">Years Combined</span><span data-lang="id">Pengalaman</span></div>
            </div>
            <div class="p-6 rounded-2xl backdrop-blur" style="background: rgba(255,255,255,0.08);">
              <div class="text-4xl font-medium mb-2" style="font-family: 'Fraunces', Georgia, serif; color: #5BAFA9;">4</div>
              <div class="text-xs uppercase tracking-wider"><span data-lang="en">Impact Areas</span><span data-lang="id">Area Dampak</span></div>
            </div>
            <div class="p-6 rounded-2xl backdrop-blur" style="background: rgba(255,255,255,0.08);">
              <div class="text-4xl font-medium mb-2" style="font-family: 'Fraunces', Georgia, serif; color: #5BAFA9;">8</div>
              <div class="text-xs uppercase tracking-wider"><span data-lang="en">Sections in this Brief</span><span data-lang="id">Bagian Brief</span></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Pull quote -->
    <section class="py-20 border-b border-[#1A2E4A]/10" style="background: #FAF6EC;">
      <div class="container-x max-w-4xl text-center">
        <p class="text-2xl md:text-3xl leading-snug" style="font-family: 'Fraunces', Georgia, serif;">
          <span data-lang="en">Sustainability is not a side report. It is a business decision.</span>
          <span data-lang="id">Keberlanjutan bukan laporan sampingan. Itu adalah keputusan bisnis.</span>
        </p>
      </div>
    </section>

    <!-- 1 + 2. Who We Are & Who We Serve -->
    <section class="py-24 border-b border-[#1A2E4A]/10">
      <div class="container-x max-w-6xl grid md:grid-cols-2 gap-16">
        <div>
          <div class="inline-block px-3 py-1 mb-6 rounded-full text-xs uppercase tracking-wider font-medium" style="background: #FAF6EC; color: #3D8F8A;">01 · Identity</div>
          <h2 class="text-4xl mb-8 leading-tight" style="font-family: 'Fraunces', Georgia, serif;">
            <span data-lang="en">{profile.whoWeAre.title.en}</span>
            <span data-lang="id">{profile.whoWeAre.title.id}</span>
          </h2>
          <div class="space-y-5">
            {profile.whoWeAre.body.en.map((p, i) => (
              <p class="text-lg leading-[1.7]" style="color: #4A5568;">
                <span data-lang="en">{p}</span>
                <span data-lang="id">{profile.whoWeAre.body.id[i]}</span>
              </p>
            ))}
          </div>
        </div>
        <div class="md:pl-8 md:border-l border-[#1A2E4A]/10">
          <div class="inline-block px-3 py-1 mb-6 rounded-full text-xs uppercase tracking-wider font-medium" style="background: #FAF6EC; color: #3D8F8A;">02 · Constituency</div>
          <h2 class="text-4xl mb-8 leading-tight" style="font-family: 'Fraunces', Georgia, serif;">
            <span data-lang="en">{profile.whoWeServe.title.en}</span>
            <span data-lang="id">{profile.whoWeServe.title.id}</span>
          </h2>
          <p class="text-lg leading-[1.7]" style="color: #4A5568;">
            <span data-lang="en">{profile.whoWeServe.body.en}</span>
            <span data-lang="id">{profile.whoWeServe.body.id}</span>
          </p>
        </div>
      </div>
    </section>

    <!-- 3. The Gap -->
    <section class="py-24 border-b border-[#1A2E4A]/10" style="background: #FAF6EC;">
      <div class="container-x max-w-6xl">
        <div class="inline-block px-3 py-1 mb-6 rounded-full text-xs uppercase tracking-wider font-medium" style="background: white; color: #3D8F8A;">03 · Thesis</div>
        <h2 class="text-5xl mb-12 max-w-3xl leading-tight" style="font-family: 'Fraunces', Georgia, serif;">
          <span data-lang="en">{profile.theGap.title.en}</span>
          <span data-lang="id">{profile.theGap.title.id}</span>
        </h2>
        <div class="grid md:grid-cols-2 gap-x-12 gap-y-6 max-w-5xl">
          {profile.theGap.body.en.map((p, i) => (
            <p class="text-lg leading-[1.7]" style="color: #4A5568;">
              <span data-lang="en">{p}</span>
              <span data-lang="id">{profile.theGap.body.id[i]}</span>
            </p>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. Approach as flow diagram -->
    <section class="py-24 border-b border-[#1A2E4A]/10">
      <div class="container-x max-w-6xl">
        <div class="inline-block px-3 py-1 mb-6 rounded-full text-xs uppercase tracking-wider font-medium" style="background: #FAF6EC; color: #3D8F8A;">04 · Methodology</div>
        <h2 class="text-4xl mb-16 max-w-3xl leading-tight" style="font-family: 'Fraunces', Georgia, serif;">
          <span data-lang="en" set:html={kicker.approachTitle.en}></span>
          <span data-lang="id" set:html={kicker.approachTitle.id}></span>
        </h2>
        <div class="relative">
          <div class="hidden md:block absolute top-10 left-[10%] right-[10%] h-px" style="background: linear-gradient(90deg, transparent, #3D8F8A, transparent);"></div>
          <div class="grid md:grid-cols-3 gap-8 relative">
            {stages.map(s => (
              <div class="text-center">
                <div class="w-20 h-20 mx-auto mb-6 rounded-full flex items-center justify-center text-2xl font-medium relative z-10" style="background: #1A2E4A; color: white; font-family: 'Fraunces', Georgia, serif;">{s.num}</div>
                <h3 class="text-2xl mb-4" style="font-family: 'Fraunces', Georgia, serif;">
                  <span data-lang="en">{s.title.en}</span>
                  <span data-lang="id">{s.title.id}</span>
                </h3>
                <p class="text-base leading-[1.7] max-w-xs mx-auto" style="color: #4A5568;">
                  <span data-lang="en">{s.body.en}</span>
                  <span data-lang="id">{s.body.id}</span>
                </p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Services as cards -->
    <section class="py-24 border-b border-[#1A2E4A]/10">
      <div class="container-x max-w-6xl">
        <div class="inline-block px-3 py-1 mb-6 rounded-full text-xs uppercase tracking-wider font-medium" style="background: #FAF6EC; color: #3D8F8A;">05 · Service Lines</div>
        <h2 class="text-4xl mb-16 leading-tight" style="font-family: 'Fraunces', Georgia, serif;">
          <span data-lang="en">Three integrated services.</span>
          <span data-lang="id">Tiga layanan terintegrasi.</span>
        </h2>
        <div class="space-y-8">
          {services.map(svc => (
            <div class="grid md:grid-cols-12 gap-8 p-8 md:p-12 rounded-3xl" style="background: #FAF6EC;">
              <div class="md:col-span-3">
                <div class="text-7xl font-medium mb-4" style="color: #3D8F8A; font-family: 'Fraunces', Georgia, serif;">{svc.num}</div>
                <h3 class="text-2xl leading-tight" style="font-family: 'Fraunces', Georgia, serif;">
                  <span data-lang="en">{svc.title.en}</span>
                  <span data-lang="id">{svc.title.id}</span>
                </h3>
              </div>
              <div class="md:col-span-9 space-y-4">
                {svc.detail.en.map((p, j) => (
                  <p class="text-lg leading-[1.7]" style="color: #4A5568;">
                    <span data-lang="en">{p}</span>
                    <span data-lang="id">{svc.detail.id[j]}</span>
                  </p>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. Impact -->
    <section class="py-24 border-b border-[#1A2E4A]/10" style="background: #1A2E4A; color: white;">
      <div class="container-x max-w-6xl">
        <div class="inline-block px-3 py-1 mb-6 rounded-full text-xs uppercase tracking-wider font-medium" style="background: rgba(255,255,255,0.1); color: #C9A876;">06 · Evidence</div>
        <h2 class="text-4xl mb-16 leading-tight" style="font-family: 'Fraunces', Georgia, serif;">
          <span data-lang="en">Proof of execution.</span>
          <span data-lang="id">Bukti eksekusi.</span>
        </h2>
        <div class="grid md:grid-cols-2 gap-x-12 gap-y-12">
          {impactCards.map(c => (
            <div class="border-t-2 pt-6" style="border-color: #5BAFA9;">
              <div class="text-xs uppercase tracking-widest font-medium mb-4" style="color: #C9A876;">
                <span data-lang="en">{c.tag.en}</span>
                <span data-lang="id">{c.tag.id}</span>
              </div>
              <h3 class="text-2xl mb-4 leading-snug" style="font-family: 'Fraunces', Georgia, serif;">
                <span data-lang="en">{c.title.en}</span>
                <span data-lang="id">{c.title.id}</span>
              </h3>
              <p class="text-base leading-[1.7] text-white/80">
                <span data-lang="en">{c.body.en}</span>
                <span data-lang="id">{c.body.id}</span>
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 7. Team -->
    <section class="py-24 border-b border-[#1A2E4A]/10">
      <div class="container-x max-w-6xl">
        <div class="inline-block px-3 py-1 mb-6 rounded-full text-xs uppercase tracking-wider font-medium" style="background: #FAF6EC; color: #3D8F8A;">07 · People</div>
        <h2 class="text-4xl mb-16 leading-tight" style="font-family: 'Fraunces', Georgia, serif;">
          <span data-lang="en">Practitioners, not analysts.</span>
          <span data-lang="id">Praktisi, bukan analis.</span>
        </h2>
        <div class="grid md:grid-cols-2 gap-8">
          {team.map(m => (
            <div class="p-8 rounded-3xl border border-[#1A2E4A]/10">
              <div class="flex items-center gap-4 mb-6">
                <div class="w-16 h-16 rounded-2xl flex items-center justify-center text-xl font-medium shrink-0" style="background: linear-gradient(135deg, #3D8F8A, #1A2E4A); color: white; font-family: 'Fraunces', Georgia, serif;">{m.initials}</div>
                <div>
                  <h3 class="text-xl leading-tight" style="font-family: 'Fraunces', Georgia, serif;">{m.name}</h3>
                  <div class="text-xs uppercase tracking-widest mt-1" style="color: #3D8F8A;">
                    <span data-lang="en">{m.role.en}</span>
                    <span data-lang="id">{m.role.id}</span>
                  </div>
                </div>
              </div>
              <p class="text-base leading-[1.7]" style="color: #4A5568;">
                <span data-lang="en">{m.bioFull.en}</span>
                <span data-lang="id">{m.bioFull.id}</span>
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 8. Closing -->
    <section class="py-32" style="background: #FAF6EC;">
      <div class="container-x max-w-4xl text-center">
        <div class="inline-block px-3 py-1 mb-6 rounded-full text-xs uppercase tracking-wider font-medium" style="background: white; color: #3D8F8A;">08 · Engagement</div>
        <h2 class="text-5xl mb-12 leading-tight" style="font-family: 'Fraunces', Georgia, serif;">
          <span data-lang="en">{profile.whatComesNext.title.en}</span>
          <span data-lang="id">{profile.whatComesNext.title.id}</span>
        </h2>
        <div class="space-y-6 mb-12 text-left">
          {profile.whatComesNext.body.en.map((p, i) => (
            <p class="text-lg leading-[1.7]" style="color: #4A5568;">
              <span data-lang="en">{p}</span>
              <span data-lang="id">{profile.whatComesNext.body.id[i]}</span>
            </p>
          ))}
        </div>
        <a href={`mailto:${brand.email}`} class="inline-block px-10 py-4 rounded-full font-medium" style="background: #3D8F8A; color: white;">{brand.email}</a>
      </div>
    </section>
  </div>
</ProfileLayout>
