---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  styleNum: number;
  styleName: string;
  title?: string;
}

const { styleNum, styleName, title = 'Company Profile' } = Astro.props;
const base = import.meta.env.BASE_URL;

const styleLinks = Array.from({ length: 10 }, (_, i) => i + 1);
---
<BaseLayout title={`${title} · Style ${String(styleNum).padStart(2, '0')}`}>
  <!-- Style switcher bar (sticky bottom) -->
  <div class="fixed bottom-6 inset-x-0 z-40 pointer-events-none">
    <div class="container-x flex justify-center">
      <div class="pointer-events-auto bg-white/95 backdrop-blur-md border border-[#E2E6EC] shadow-2xl rounded-full px-3 py-2 flex items-center gap-1 max-w-full overflow-x-auto">
        <a href={base + '/profile'} class="text-xs font-semibold uppercase tracking-wider px-3 py-1.5 text-[#5C6B7E] hover:text-[#1A2E4A] whitespace-nowrap">
          ← <span data-lang="en">Gallery</span><span data-lang="id">Galeri</span>
        </a>
        <div class="w-px h-5 bg-[#E2E6EC]"></div>
        {styleLinks.map(n => (
          <a href={`${base}/profile/style-${n}`} class={`px-3 py-1.5 text-xs font-semibold rounded-full transition-colors ${n === styleNum ? 'bg-[#1A2E4A] text-white' : 'text-[#5C6B7E] hover:bg-[#F0F3F8]'}`}>
            {String(n).padStart(2, '0')}
          </a>
        ))}
        <div class="w-px h-5 bg-[#E2E6EC]"></div>
        <a href={`${base}/styleguide/${styleNum}`} class="text-xs font-semibold uppercase tracking-wider px-3 py-1.5 text-[#3D8F8A] hover:text-[#1A2E4A] whitespace-nowrap" title="View design system for this style">
          <span data-lang="en">System</span><span data-lang="id">Sistem</span> →
        </a>
      </div>
    </div>
  </div>

  <slot />
</BaseLayout>
