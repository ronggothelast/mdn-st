---
// STYLE 02 — Stripe Minimal
import ProfileLayout from '../../layouts/ProfileLayout.astro';
import { brand, profile, services, team, stages, impactCards, kicker } from '../../data/content';
const base = import.meta.env.BASE_URL;
---
<ProfileLayout styleNum={2} styleName="Stripe Minimal">
  <div style="background: #F7F9FC; color: #0A2540; font-family: 'Inter', sans-serif;">
    <section class="py-32 px-6">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-6xl md:text-8xl font-bold tracking-tight mb-8" style="background: linear-gradient(135deg, #0A2540, #635BFF); -webkit-background-clip: text; color: transparent;">{brand.name}</h1>
        <p class="text-3xl font-light text-[#425466] mb-12">
          <span data-lang="en">{brand.tagline.en}</span><span data-lang="id">{brand.tagline.id}</span>
        </p>
      </div>
    </section>

    <!-- Who We Are -->
    <section class="py-24 px-6 bg-white border-y border-[#E6E8EB]">
      <div class="max-w-4xl mx-auto grid md:grid-cols-[1fr_2fr] gap-12">
        <h2 class="text-2xl font-bold"><span data-lang="en">{profile.whoWeAre.title.en}</span><span data-lang="id">{profile.whoWeAre.title.id}</span></h2>
        <div class="space-y-6">
          {profile.whoWeAre.body.en.map((p, i) => (
            <p class="text-lg text-[#425466] leading-relaxed"><span data-lang="en">{p}</span><span data-lang="id">{profile.whoWeAre.body.id[i]}</span></p>
          ))}
        </div>
      </div>
    </section>

    <!-- Who We Serve -->
    <section class="py-24 px-6">
      <div class="max-w-4xl mx-auto grid md:grid-cols-[1fr_2fr] gap-12">
        <h2 class="text-2xl font-bold"><span data-lang="en">{profile.whoWeServe.title.en}</span><span data-lang="id">{profile.whoWeServe.title.id}</span></h2>
        <p class="text-lg text-[#425466] leading-relaxed"><span data-lang="en">{profile.whoWeServe.body.en}</span><span data-lang="id">{profile.whoWeServe.body.id}</span></p>
      </div>
    </section>

    <!-- The Gap -->
    <section class="py-24 px-6 bg-[#0A2540] text-white">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-4xl font-bold mb-12"><span data-lang="en">{profile.theGap.title.en}</span><span data-lang="id">{profile.theGap.title.id}</span></h2>
        <div class="space-y-6 max-w-2xl">
          {profile.theGap.body.en.map((p, i) => (
            <p class="text-lg text-white/80 leading-relaxed"><span data-lang="en">{p}</span><span data-lang="id">{profile.theGap.body.id[i]}</span></p>
          ))}
        </div>
      </div>
    </section>

    <!-- Approach -->
    <section class="py-24 px-6">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-12 text-center">
          <span data-lang="en" set:html={kicker.approachTitle.en}></span>
          <span data-lang="id" set:html={kicker.approachTitle.id}></span>
        </h2>
        <div class="grid md:grid-cols-3 gap-8">
          {stages.map(s => (
            <div class="bg-white p-8 rounded-2xl shadow-sm border border-[#E6E8EB]">
              <div class="text-[#635BFF] font-mono text-sm mb-4">STEP {s.num}</div>
              <h3 class="text-xl font-bold mb-3"><span data-lang="en">{s.title.en}</span><span data-lang="id">{s.title.id}</span></h3>
              <p class="text-[#425466] leading-relaxed"><span data-lang="en">{s.body.en}</span><span data-lang="id">{s.body.id}</span></p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Services -->
    <section class="py-24 px-6 bg-white border-y border-[#E6E8EB]">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-16"><span data-lang="en">Services</span><span data-lang="id">Layanan</span></h2>
        <div class="space-y-16">
          {services.map(svc => (
            <div>
              <div class="flex items-center gap-4 mb-6">
                <span class="bg-[#F3F3F5] text-[#0A2540] px-3 py-1 rounded-full text-sm font-bold">{svc.num}</span>
                <h3 class="text-2xl font-bold"><span data-lang="en">{svc.title.en}</span><span data-lang="id">{svc.title.id}</span></h3>
              </div>
              <div class="pl-12 space-y-4 max-w-2xl">
                {svc.detail.en.map((p, j) => (
                  <p class="text-[#425466] leading-relaxed"><span data-lang="en">{p}</span><span data-lang="id">{svc.detail.id[j]}</span></p>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Impact Cards -->
    <section class="py-24 px-6">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-12"><span data-lang="en">Proof of Execution</span><span data-lang="id">Bukti Eksekusi</span></h2>
        <div class="grid md:grid-cols-2 gap-6">
          {impactCards.map(c => (
            <div class="bg-white p-6 rounded-xl border border-[#E6E8EB] hover:shadow-md transition">
              <div class="text-xs font-bold text-[#635BFF] uppercase tracking-wider mb-2"><span data-lang="en">{c.tag.en}</span><span data-lang="id">{c.tag.id}</span></div>
              <h3 class="text-lg font-bold mb-2"><span data-lang="en">{c.title.en}</span><span data-lang="id">{c.title.id}</span></h3>
              <p class="text-sm text-[#425466]"><span data-lang="en">{c.body.en}</span><span data-lang="id">{c.body.id}</span></p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Team -->
    <section class="py-24 px-6 bg-white border-y border-[#E6E8EB]">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-16"><span data-lang="en">Team</span><span data-lang="id">Tim</span></h2>
        <div class="grid md:grid-cols-2 gap-12">
          {team.map(m => (
            <div>
              <div class="w-16 h-16 bg-[#F3F3F5] rounded-full flex items-center justify-center font-bold text-[#0A2540] mb-4">{m.initials}</div>
              <h3 class="text-xl font-bold">{m.name}</h3>
              <div class="text-sm text-[#635BFF] font-medium mb-3"><span data-lang="en">{m.role.en}</span><span data-lang="id">{m.role.id}</span></div>
              <p class="text-[#425466] leading-relaxed text-sm"><span data-lang="en">{m.bioFull.en}</span><span data-lang="id">{m.bioFull.id}</span></p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Closing -->
    <section class="py-32 px-6 text-center">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-4xl font-bold mb-8"><span data-lang="en">{profile.whatComesNext.title.en}</span><span data-lang="id">{profile.whatComesNext.title.id}</span></h2>
        {profile.whatComesNext.body.en.map((p, i) => (
          <p class="text-lg text-[#425466] mb-4"><span data-lang="en">{p}</span><span data-lang="id">{profile.whatComesNext.body.id[i]}</span></p>
        ))}
        <a href={`mailto:${brand.email}`} class="inline-block mt-8 bg-[#635BFF] text-white px-8 py-3 rounded-full font-bold hover:bg-[#0A2540] transition">{brand.email}</a>
      </div>
    </section>
  </div>
</ProfileLayout>
