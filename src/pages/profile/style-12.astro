---
// STYLE 12 — Linear Mono (V2 white-dominant collection)
// Swiss/grid-based: numbered columns, hairline rules, navy-on-white minimalism.
import ProfileLayout from '../../layouts/ProfileLayout.astro';
import { brand, profile, services, team, stages, impactCards, kicker } from '../../data/content';
const base = import.meta.env.BASE_URL;
---
<ProfileLayout styleNum={12} styleName="Linear Mono">
  <div style="background:#FFFFFF;color:#1A2E4A;font-family:'Inter', sans-serif;">

    <!-- Hero — single huge column on the right, label on the left -->
    <section class="border-b" style="border-color:#1A2E4A;padding:6rem 0 8rem;">
      <div class="container-x max-w-[76rem]">
        <div class="grid md:grid-cols-12 gap-6">
          <div class="md:col-span-3">
            <div class="font-mono text-xs tracking-[0.2em] uppercase" style="color:#3D8F8A;">M / 01</div>
          </div>
          <div class="md:col-span-9">
            <h1 class="text-[clamp(2.75rem,8vw,7rem)] leading-[0.95] font-bold tracking-[-0.04em] mb-10">{brand.name}</h1>
            <p class="text-2xl leading-snug max-w-2xl" style="color:#71717A;">
              <span data-lang="en">{brand.tagline.en}</span>
              <span data-lang="id">{brand.tagline.id}</span>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 01 Identity -->
    <section class="border-b" style="border-color:#1A2E4A;padding:5rem 0;">
      <div class="container-x max-w-[76rem] grid md:grid-cols-12 gap-6">
        <div class="md:col-span-3">
          <div class="font-mono text-xs tracking-[0.2em] uppercase" style="color:#3D8F8A;">01 / Identity</div>
        </div>
        <div class="md:col-span-9">
          <h2 class="text-4xl md:text-5xl font-bold mb-8 tracking-[-0.03em]">
            <span data-lang="en">{profile.whoWeAre.title.en}</span>
            <span data-lang="id">{profile.whoWeAre.title.id}</span>
          </h2>
          <div class="space-y-5 max-w-3xl">
            {profile.whoWeAre.body.en.map((p, i) => (
              <p class="text-lg leading-[1.7]" style={`color:#71717A;`}>
                <span data-lang="en">{p}</span>
                <span data-lang="id">{profile.whoWeAre.body.id[i]}</span>
              </p>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 02 Clients -->
    <section class="border-b" style="border-color:#1A2E4A;padding:5rem 0;">
      <div class="container-x max-w-[76rem] grid md:grid-cols-12 gap-6">
        <div class="md:col-span-3">
          <div class="font-mono text-xs tracking-[0.2em] uppercase" style="color:#3D8F8A;">02 / Clients</div>
        </div>
        <div class="md:col-span-9">
          <h2 class="text-4xl md:text-5xl font-bold mb-8 tracking-[-0.03em]">
            <span data-lang="en">{profile.whoWeServe.title.en}</span>
            <span data-lang="id">{profile.whoWeServe.title.id}</span>
          </h2>
          <p class="text-lg leading-[1.7] max-w-3xl" style="color:#71717A;">
            <span data-lang="en">{profile.whoWeServe.body.en}</span>
            <span data-lang="id">{profile.whoWeServe.body.id}</span>
          </p>
        </div>
      </div>
    </section>

    <!-- 03 Thesis -->
    <section class="border-b" style="border-color:#1A2E4A;padding:5rem 0;">
      <div class="container-x max-w-[76rem] grid md:grid-cols-12 gap-6">
        <div class="md:col-span-3">
          <div class="font-mono text-xs tracking-[0.2em] uppercase" style="color:#3D8F8A;">03 / Thesis</div>
        </div>
        <div class="md:col-span-9">
          <h2 class="text-4xl md:text-5xl font-bold mb-8 tracking-[-0.03em]">
            <span data-lang="en">{profile.theGap.title.en}</span>
            <span data-lang="id">{profile.theGap.title.id}</span>
          </h2>
          <div class="space-y-5 max-w-3xl">
            {profile.theGap.body.en.map((p, i) => (
              <p class="text-lg leading-[1.7]" style={`color:#71717A;`}>
                <span data-lang="en">{p}</span>
                <span data-lang="id">{profile.theGap.body.id[i]}</span>
              </p>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 04 Methodology -->
    <section class="border-b" style="border-color:#1A2E4A;padding:5rem 0;">
      <div class="container-x max-w-[76rem]">
        <div class="grid md:grid-cols-12 gap-6 mb-12">
          <div class="md:col-span-3">
            <div class="font-mono text-xs tracking-[0.2em] uppercase" style="color:#3D8F8A;">04 / Method</div>
          </div>
          <div class="md:col-span-9">
            <h2 class="text-4xl md:text-5xl font-bold tracking-[-0.03em]">
              <span data-lang="en" set:html={kicker.approachTitle.en}></span>
              <span data-lang="id" set:html={kicker.approachTitle.id}></span>
            </h2>
          </div>
        </div>
        <div class="grid md:grid-cols-3 gap-10 pt-10 border-t" style="border-color:#1A2E4A;">
          {stages.map(s => (
            <div>
              <div class="font-mono text-xs mb-4" style={`color:#3D8F8A;`}>{s.num}</div>
              <h3 class="text-xl font-bold mb-3 tracking-[-0.02em]">
                <span data-lang="en">{s.title.en}</span>
                <span data-lang="id">{s.title.id}</span>
              </h3>
              <p class="text-base leading-[1.7]" style={`color:#71717A;`}>
                <span data-lang="en">{s.body.en}</span>
                <span data-lang="id">{s.body.id}</span>
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 05 Services -->
    <section class="border-b" style="border-color:#1A2E4A;padding:5rem 0;">
      <div class="container-x max-w-[76rem]">
        <div class="grid md:grid-cols-12 gap-6 mb-12">
          <div class="md:col-span-3">
            <div class="font-mono text-xs tracking-[0.2em] uppercase" style="color:#3D8F8A;">05 / Services</div>
          </div>
          <div class="md:col-span-9">
            <h2 class="text-4xl md:text-5xl font-bold tracking-[-0.03em]">
              <span data-lang="en">Three integrated services.</span>
              <span data-lang="id">Tiga layanan terintegrasi.</span>
            </h2>
          </div>
        </div>
        <div class="space-y-12">
          {services.map(svc => (
            <div class="grid md:grid-cols-12 gap-6 pb-10 border-b last:border-0" style={`border-color:#1A2E4A;`}>
              <div class="md:col-span-3">
                <div class="font-mono text-xs mb-2" style={`color:#3D8F8A;`}>S/{svc.num}</div>
                <h3 class="text-2xl font-bold tracking-[-0.02em] leading-tight">
                  <span data-lang="en">{svc.title.en}</span>
                  <span data-lang="id">{svc.title.id}</span>
                </h3>
              </div>
              <div class="md:col-span-9 space-y-4">
                {svc.detail.en.map((p, j) => (
                  <p class="text-base leading-[1.7]" style={`color:#71717A;`}>
                    <span data-lang="en">{p}</span>
                    <span data-lang="id">{svc.detail.id[j]}</span>
                  </p>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 06 Evidence -->
    <section class="border-b" style="border-color:#1A2E4A;padding:5rem 0;">
      <div class="container-x max-w-[76rem]">
        <div class="grid md:grid-cols-12 gap-6 mb-12">
          <div class="md:col-span-3">
            <div class="font-mono text-xs tracking-[0.2em] uppercase" style="color:#3D8F8A;">06 / Evidence</div>
          </div>
          <div class="md:col-span-9">
            <h2 class="text-4xl md:text-5xl font-bold tracking-[-0.03em]">
              <span data-lang="en">Proof of execution.</span>
              <span data-lang="id">Bukti eksekusi.</span>
            </h2>
          </div>
        </div>
        <div class="grid md:grid-cols-2 gap-x-10 gap-y-10">
          {impactCards.map(c => (
            <div class="border-t pt-5" style={`border-color:#1A2E4A;`}>
              <div class="font-mono text-xs uppercase tracking-[0.2em] mb-3" style={`color:#3D8F8A;`}>
                <span data-lang="en">{c.tag.en}</span>
                <span data-lang="id">{c.tag.id}</span>
              </div>
              <h3 class="text-xl mb-3 font-bold leading-snug tracking-[-0.02em]">
                <span data-lang="en">{c.title.en}</span>
                <span data-lang="id">{c.title.id}</span>
              </h3>
              <p class="text-base leading-[1.6]" style={`color:#71717A;`}>
                <span data-lang="en">{c.body.en}</span>
                <span data-lang="id">{c.body.id}</span>
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 07 People -->
    <section class="border-b" style="border-color:#1A2E4A;padding:5rem 0;">
      <div class="container-x max-w-[76rem]">
        <div class="grid md:grid-cols-12 gap-6 mb-12">
          <div class="md:col-span-3">
            <div class="font-mono text-xs tracking-[0.2em] uppercase" style="color:#3D8F8A;">07 / People</div>
          </div>
          <div class="md:col-span-9">
            <h2 class="text-4xl md:text-5xl font-bold tracking-[-0.03em]">
              <span data-lang="en">Practitioners, not analysts.</span>
              <span data-lang="id">Praktisi, bukan analis.</span>
            </h2>
          </div>
        </div>
        <div class="grid md:grid-cols-2 gap-10">
          {team.map(m => (
            <div class="grid grid-cols-[auto_1fr] gap-5">
              <div class="w-16 h-16 flex items-center justify-center text-lg font-bold" style={`background:#1A2E4A;color:#FFFFFF;`}>{m.initials}</div>
              <div>
                <h3 class="text-xl font-bold mb-1 leading-tight tracking-[-0.02em]">{m.name}</h3>
                <div class="font-mono text-xs uppercase tracking-[0.2em] mb-3" style={`color:#3D8F8A;`}>
                  <span data-lang="en">{m.role.en}</span>
                  <span data-lang="id">{m.role.id}</span>
                </div>
                <p class="text-sm leading-[1.7]" style={`color:#71717A;`}>
                  <span data-lang="en">{m.bioFull.en}</span>
                  <span data-lang="id">{m.bioFull.id}</span>
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 08 Engagement -->
    <section style="padding:6rem 0;">
      <div class="container-x max-w-[76rem]">
        <div class="grid md:grid-cols-12 gap-6">
          <div class="md:col-span-3">
            <div class="font-mono text-xs tracking-[0.2em] uppercase" style="color:#3D8F8A;">08 / Contact</div>
          </div>
          <div class="md:col-span-9">
            <h2 class="text-5xl md:text-6xl font-bold mb-8 tracking-[-0.04em] leading-[0.95]">
              <span data-lang="en">{profile.whatComesNext.title.en}</span>
              <span data-lang="id">{profile.whatComesNext.title.id}</span>
            </h2>
            <div class="space-y-5 mb-10 max-w-3xl">
              {profile.whatComesNext.body.en.map((p, i) => (
                <p class="text-lg leading-[1.7]" style={`color:#71717A;`}>
                  <span data-lang="en">{p}</span>
                  <span data-lang="id">{profile.whatComesNext.body.id[i]}</span>
                </p>
              ))}
            </div>
            <div class="grid md:grid-cols-2 gap-6 pt-8 border-t" style="border-color:#1A2E4A;">
              <div>
                <div class="font-mono text-xs uppercase tracking-[0.2em] mb-1" style="color:#3D8F8A;">Email</div>
                <a href={`mailto:${brand.email}`} class="text-lg font-bold">{brand.email}</a>
              </div>
              <div>
                <div class="font-mono text-xs uppercase tracking-[0.2em] mb-1" style="color:#3D8F8A;">Phone</div>
                <div class="text-lg font-bold">{brand.phone}</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</ProfileLayout>
