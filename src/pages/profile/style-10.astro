---
// STYLE 10 — Premium Folio (Coffee-table book, large imagery, gold-tan accents)
import ProfileLayout from '../../layouts/ProfileLayout.astro';
import { brand, profile, services, team, stages, impactCards, kicker } from '../../data/content';
const base = import.meta.env.BASE_URL;
---
<ProfileLayout styleNum={10} styleName="Premium Folio">
  <div style="background: #FAF6EC; color: #1A2E4A; font-family: 'Fraunces', Georgia, serif;">
    <!-- Cover - editorial style -->
    <header class="min-h-screen relative overflow-hidden">
      <img src={base + '/assets/images/forest.png'} alt="" class="absolute inset-0 w-full h-full object-cover" />
      <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(26,46,74,0.65) 0%, rgba(26,46,74,0.95) 100%);"></div>
      
      <div class="relative h-screen flex flex-col justify-between py-20" style="color: #FAF6EC;">
        <div class="container-x max-w-6xl">
          <div class="flex justify-between items-start text-xs uppercase tracking-[0.4em] font-sans">
            <div style="color: #C9A876;">Madani Strategies</div>
            <div style="color: #C9A876;">Vol. 01 · MMXXVI</div>
          </div>
        </div>
        
        <div class="container-x max-w-6xl">
          <div class="text-xs font-sans uppercase tracking-[0.5em] mb-12" style="color: #C9A876;">
            <span data-lang="en">— A Strategic Impact Folio —</span>
            <span data-lang="id">— Sebuah Folio Dampak Strategis —</span>
          </div>
          <h1 class="text-[clamp(4rem,11vw,10rem)] font-medium leading-[0.9] tracking-tight mb-12">{brand.name}</h1>
          <p class="text-3xl italic max-w-3xl leading-tight" style="color: rgba(250,246,236,0.9);">
            <span data-lang="en">{brand.tagline.en}</span>
            <span data-lang="id">{brand.tagline.id}</span>
          </p>
        </div>

        <div class="container-x max-w-6xl">
          <div class="flex justify-between items-end pt-8 border-t border-[#C9A876]/40 text-sm font-sans">
            <div style="color: #C9A876;">{brand.web}</div>
            <div class="text-right" style="color: #C9A876;">
              <span data-lang="en">A Company Profile</span>
              <span data-lang="id">Sebuah Profil Perusahaan</span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Opening dedication / mission -->
    <section class="py-32 text-center border-b border-[#C9A876]/40">
      <div class="container-x max-w-3xl">
        <div class="text-xs font-sans uppercase tracking-[0.4em] mb-8" style="color: #C9A876;">
          <span data-lang="en">— A Note from the Founders —</span>
          <span data-lang="id">— Catatan dari Para Pendiri —</span>
        </div>
        <p class="text-3xl italic leading-[1.5]" style="color: #1A2E4A;">
          <span data-lang="en">We work where growth meets community — turning complex social and environmental challenges into clear strategic decisions, then executing alongside the people most affected.</span>
          <span data-lang="id">Kami bekerja di titik temu pertumbuhan dan komunitas — mengubah tantangan sosial dan lingkungan yang kompleks menjadi keputusan strategis yang jelas, lalu mengeksekusi bersama orang-orang yang paling terdampak.</span>
        </p>
      </div>
    </section>

    <!-- I. Who We Are - large image + text -->
    <section class="py-32 border-b border-[#C9A876]/40">
      <div class="container-x max-w-6xl">
        <div class="grid md:grid-cols-12 gap-12 items-center mb-16">
          <div class="md:col-span-5">
            <div class="aspect-[4/5] overflow-hidden">
              <img src={base + '/assets/images/hero-community.png'} alt="" class="w-full h-full object-cover" />
            </div>
          </div>
          <div class="md:col-span-7">
            <div class="text-xs font-sans uppercase tracking-[0.4em] mb-4" style="color: #C9A876;">~ Folio I ~</div>
            <h2 class="text-6xl mb-8 leading-tight">
              <span data-lang="en">{profile.whoWeAre.title.en}</span>
              <span data-lang="id">{profile.whoWeAre.title.id}</span>
            </h2>
            <div class="space-y-6">
              {profile.whoWeAre.body.en.map((p, i) => (
                <p class={`text-xl leading-[1.7] ${i === 0 ? 'dropcap' : ''}`}>
                  <span data-lang="en">{p}</span>
                  <span data-lang="id">{profile.whoWeAre.body.id[i]}</span>
                </p>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- II. Who We Serve -->
    <section class="py-32 border-b border-[#C9A876]/40" style="background: #F4ECDB;">
      <div class="container-x max-w-4xl text-center">
        <div class="text-xs font-sans uppercase tracking-[0.4em] mb-4" style="color: #C9A876;">~ Folio II ~</div>
        <h2 class="text-5xl mb-12 leading-tight">
          <span data-lang="en">{profile.whoWeServe.title.en}</span>
          <span data-lang="id">{profile.whoWeServe.title.id}</span>
        </h2>
        <p class="text-2xl italic leading-[1.7]" style="color: #4A5568;">
          <span data-lang="en">{profile.whoWeServe.body.en}</span>
          <span data-lang="id">{profile.whoWeServe.body.id}</span>
        </p>
      </div>
    </section>

    <!-- III. The Gap - dark contrast -->
    <section class="py-32 border-b border-[#C9A876]/40" style="background: #1A2E4A; color: #FAF6EC;">
      <div class="container-x max-w-4xl">
        <div class="text-xs font-sans uppercase tracking-[0.4em] mb-4" style="color: #C9A876;">~ Folio III ~</div>
        <h2 class="text-6xl mb-12 leading-tight">
          <span data-lang="en">{profile.theGap.title.en}</span>
          <span data-lang="id">{profile.theGap.title.id}</span>
        </h2>
        <div class="space-y-6">
          {profile.theGap.body.en.map((p, i) => (
            <p class="text-xl leading-[1.7]">
              <span data-lang="en">{p}</span>
              <span data-lang="id">{profile.theGap.body.id[i]}</span>
            </p>
          ))}
        </div>
      </div>
    </section>

    <!-- IV. Approach -->
    <section class="py-32 border-b border-[#C9A876]/40">
      <div class="container-x max-w-6xl">
        <div class="text-center mb-20">
          <div class="text-xs font-sans uppercase tracking-[0.4em] mb-4" style="color: #C9A876;">~ Folio IV ~</div>
          <h2 class="text-5xl leading-tight max-w-3xl mx-auto">
            <span data-lang="en" set:html={kicker.approachTitle.en}></span>
            <span data-lang="id" set:html={kicker.approachTitle.id}></span>
          </h2>
        </div>
        <div class="grid md:grid-cols-3 gap-12">
          {stages.map(s => (
            <div class="text-center">
              <div class="inline-flex items-center justify-center w-32 h-32 rounded-full mb-8 text-5xl font-medium" style="background: #C9A876; color: #1A2E4A;">{s.num}</div>
              <h3 class="text-3xl mb-6 leading-tight">
                <span data-lang="en">{s.title.en}</span>
                <span data-lang="id">{s.title.id}</span>
              </h3>
              <p class="text-lg leading-[1.7]" style="color: #4A5568;">
                <span data-lang="en">{s.body.en}</span>
                <span data-lang="id">{s.body.id}</span>
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- V. Services - alternating large -->
    <section class="py-32 border-b border-[#C9A876]/40">
      <div class="container-x max-w-6xl">
        <div class="text-center mb-20">
          <div class="text-xs font-sans uppercase tracking-[0.4em] mb-4" style="color: #C9A876;">~ Folio V ~</div>
          <h2 class="text-5xl leading-tight">
            <span data-lang="en">Three Services</span>
            <span data-lang="id">Tiga Layanan</span>
          </h2>
        </div>
        <div class="space-y-32">
          {services.map((svc, i) => (
            <article class={`grid md:grid-cols-12 gap-12 items-center ${i % 2 === 1 ? 'md:flex-row-reverse' : ''}`}>
              <div class={`md:col-span-6 ${i % 2 === 1 ? 'md:order-2' : ''}`}>
                <div class="aspect-[4/5] overflow-hidden">
                  <img src={svc.image} alt={svc.title.en} class="w-full h-full object-cover" />
                </div>
              </div>
              <div class={`md:col-span-6 ${i % 2 === 1 ? 'md:order-1' : ''}`}>
                <div class="text-7xl font-medium mb-4" style="color: #C9A876;">{svc.num}</div>
                <h3 class="text-4xl mb-8 leading-tight">
                  <span data-lang="en">{svc.title.en}</span>
                  <span data-lang="id">{svc.title.id}</span>
                </h3>
                <div class="space-y-5">
                  {svc.detail.en.map((p, j) => (
                    <p class="text-lg leading-[1.7]" style="color: #4A5568;">
                      <span data-lang="en">{p}</span>
                      <span data-lang="id">{svc.detail.id[j]}</span>
                    </p>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- VI. Impact -->
    <section class="py-32 border-b border-[#C9A876]/40" style="background: #F4ECDB;">
      <div class="container-x max-w-5xl">
        <div class="text-center mb-20">
          <div class="text-xs font-sans uppercase tracking-[0.4em] mb-4" style="color: #C9A876;">~ Folio VI ~</div>
          <h2 class="text-5xl leading-tight">
            <span data-lang="en">Proof of Execution</span>
            <span data-lang="id">Bukti Eksekusi</span>
          </h2>
        </div>
        <div class="grid md:grid-cols-2 gap-x-12 gap-y-16">
          {impactCards.map(c => (
            <div>
              <div class="text-xs font-sans uppercase tracking-[0.4em] mb-3" style="color: #3D8F8A;">
                <span data-lang="en">{c.tag.en}</span>
                <span data-lang="id">{c.tag.id}</span>
              </div>
              <h3 class="text-3xl mb-4 leading-snug">
                <span data-lang="en">{c.title.en}</span>
                <span data-lang="id">{c.title.id}</span>
              </h3>
              <p class="text-lg leading-[1.7]" style="color: #4A5568;">
                <span data-lang="en">{c.body.en}</span>
                <span data-lang="id">{c.body.id}</span>
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- VII. Team -->
    <section class="py-32 border-b border-[#C9A876]/40">
      <div class="container-x max-w-6xl">
        <div class="text-center mb-20">
          <div class="text-xs font-sans uppercase tracking-[0.4em] mb-4" style="color: #C9A876;">~ Folio VII ~</div>
          <h2 class="text-5xl leading-tight">
            <span data-lang="en">The Team</span>
            <span data-lang="id">Tim Kami</span>
          </h2>
        </div>
        <div class="grid md:grid-cols-2 gap-16">
          {team.map(m => (
            <div class="grid grid-cols-[auto_1fr] gap-6 items-start">
              <div class="aspect-square w-32 rounded-full overflow-hidden flex items-center justify-center text-4xl font-medium shrink-0" style="background: linear-gradient(135deg, #3D8F8A, #1A2E4A); color: #FAF6EC;">{m.initials}</div>
              <div>
                <h3 class="text-3xl mb-2">{m.name}</h3>
                <div class="text-xs font-sans uppercase tracking-[0.3em] mb-5" style="color: #3D8F8A;">
                  <span data-lang="en">{m.role.en}</span>
                  <span data-lang="id">{m.role.id}</span>
                </div>
                <p class="text-base leading-[1.7]" style="color: #4A5568;">
                  <span data-lang="en">{m.bioFull.en}</span>
                  <span data-lang="id">{m.bioFull.id}</span>
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- VIII. Closing -->
    <section class="py-40 text-center" style="background: #1A2E4A; color: #FAF6EC;">
      <div class="container-x max-w-3xl">
        <div class="text-xs font-sans uppercase tracking-[0.4em] mb-4" style="color: #C9A876;">~ Folio VIII ~</div>
        <h2 class="text-6xl mb-12 leading-tight">
          <span data-lang="en">{profile.whatComesNext.title.en}</span>
          <span data-lang="id">{profile.whatComesNext.title.id}</span>
        </h2>
        <div class="space-y-6 mb-16 text-left">
          {profile.whatComesNext.body.en.map((p, i) => (
            <p class="text-xl italic leading-[1.7] text-[#FAF6EC]/85">
              <span data-lang="en">{p}</span>
              <span data-lang="id">{profile.whatComesNext.body.id[i]}</span>
            </p>
          ))}
        </div>
        <div class="flex items-center justify-center gap-4 mb-12">
          <div class="h-px w-16" style="background: #C9A876;"></div>
          <div class="w-2 h-2 rounded-full" style="background: #C9A876;"></div>
          <div class="h-px w-16" style="background: #C9A876;"></div>
        </div>
        <a href={`mailto:${brand.email}`} class="inline-block px-12 py-4 rounded-full font-sans" style="background: #C9A876; color: #1A2E4A;">{brand.email}</a>
        <div class="mt-6 text-sm font-sans" style="color: rgba(250,246,236,0.7);">{brand.phone} · {brand.web}</div>
      </div>
    </section>
  </div>
</ProfileLayout>
