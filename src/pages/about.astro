---
import BaseLayout from '../layouts/BaseLayout.astro';
import { team, experts, expertsIntro, about as aboutCopy, finalCta, brand } from '../data/content';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="About">
  <!-- INTRO -->
  <section class="py-24" style="background: linear-gradient(180deg, #FAF6EC, #ffffff);">
    <div class="container-x max-w-4xl text-center">
      <span class="text-xs font-sans uppercase tracking-[0.3em]" style="color: #3D8F8A;">
        <span data-lang="en">{aboutCopy.tag.en}</span><span data-lang="id">{aboutCopy.tag.id}</span>
      </span>
      <h1 class="text-5xl md:text-6xl mt-4 mb-8 leading-tight" style="font-family: 'Fraunces', Georgia, serif;">
        <span data-lang="en">{aboutCopy.headline.en}</span>
        <span data-lang="id">{aboutCopy.headline.id}</span>
      </h1>
    </div>
  </section>

  <!-- STORY -->
  <section class="py-20 bg-white">
    <div class="container-x grid lg:grid-cols-2 gap-16 items-center max-w-6xl">
      <div class="rounded-3xl overflow-hidden aspect-[4/5]">
        <img src={base + '/assets/images/forest.png'} alt="Lush tropical forest" class="w-full h-full object-cover" />
      </div>
      <div>
        <span class="text-xs font-sans uppercase tracking-[0.3em]" style="color: #3D8F8A;">
          <span data-lang="en">Our Story</span><span data-lang="id">Cerita Kami</span>
        </span>
        <h2 class="text-4xl mt-4 mb-8 leading-tight" style="font-family: 'Fraunces', Georgia, serif;">
          <span data-lang="en">From NGO field work to strategic consulting.</span>
          <span data-lang="id">Dari kerja lapangan NGO ke konsultansi strategis.</span>
        </h2>
        {aboutCopy.body.en.map((p, i) => (
          <p class="mb-5 leading-[1.7]" style="color: #4A5568;">
            <span data-lang="en">{p}</span>
            <span data-lang="id">{aboutCopy.body.id[i]}</span>
          </p>
        ))}
      </div>
    </div>
  </section>

  <!-- CORE TEAM -->
  <section class="py-24" style="background: #FAF6EC;">
    <div class="container-x max-w-6xl">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs font-sans uppercase tracking-[0.3em]" style="color: #3D8F8A;">
          <span data-lang="en">Core Team</span><span data-lang="id">Tim Inti</span>
        </span>
        <h2 class="text-4xl mt-4 leading-tight" style="font-family: 'Fraunces', Georgia, serif;">
          <span data-lang="en">Practitioners, not just analysts.</span>
          <span data-lang="id">Praktisi, bukan sekadar analis.</span>
        </h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {team.map(m => (
          <div>
            <div class="aspect-square rounded-2xl overflow-hidden mb-4 relative" style="background: linear-gradient(135deg, #3D8F8A, #1A2E4A);">
              <div class="absolute inset-0" style="background: radial-gradient(circle at 50% 30%, rgba(255,255,255,0.15), transparent 60%);"></div>
              <div class="absolute inset-0 flex items-center justify-center">
                <span class="text-white text-5xl font-medium opacity-90" style="font-family: 'Fraunces', Georgia, serif;">{m.initials}</span>
              </div>
            </div>
            <h4 class="text-lg font-semibold mb-1">{m.name}</h4>
            <div class="text-xs font-semibold uppercase tracking-wider mb-3" style="color: #3D8F8A;">
              <span data-lang="en">{m.role.en}</span><span data-lang="id">{m.role.id}</span>
            </div>
            <p class="text-sm leading-relaxed" style="color: #4A5568;">
              <span data-lang="en">{m.bioShort.en}</span><span data-lang="id">{m.bioShort.id}</span>
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- AFFILIATED EXPERTS -->
  <section class="py-24">
    <div class="container-x max-w-5xl">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs font-sans uppercase tracking-[0.3em]" style="color: #3D8F8A;">
          <span data-lang="en">Affiliated Experts</span><span data-lang="id">Ahli Terafiliasi</span>
        </span>
        <h2 class="text-4xl mt-4 mb-4 leading-tight" style="font-family: 'Fraunces', Georgia, serif;">
          <span data-lang="en">The MaGies Network.</span>
          <span data-lang="id">Jaringan MaGies.</span>
        </h2>
        <p class="text-base" style="color: #4A5568;">
          <span data-lang="en">{expertsIntro.en}</span>
          <span data-lang="id">{expertsIntro.id}</span>
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {experts.map(e => (
          <div class="p-6 rounded-2xl border" style="border-color: rgba(26,46,74,0.12);">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-14 h-14 rounded-full flex items-center justify-center text-lg font-medium shrink-0" style="background: #C9A876; color: #1A2E4A; font-family: 'Fraunces', Georgia, serif;">{e.initials}</div>
              <div>
                <h4 class="font-semibold leading-tight">{e.name}</h4>
                <div class="text-xs font-medium uppercase tracking-wider mt-1" style="color: #3D8F8A;">
                  <span data-lang="en">{e.role.en}</span><span data-lang="id">{e.role.id}</span>
                </div>
              </div>
            </div>
            <p class="text-sm leading-relaxed" style="color: #4A5568;">
              <span data-lang="en">{e.bio.en}</span><span data-lang="id">{e.bio.id}</span>
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="py-24" style="background: #1A2E4A; color: #FAF6EC;">
    <div class="container-x max-w-4xl text-center">
      <h2 class="text-4xl md:text-5xl mb-6 leading-tight" style="font-family: 'Fraunces', Georgia, serif;">
        <span data-lang="en">{finalCta.headline.en}</span>
        <span data-lang="id">{finalCta.headline.id}</span>
      </h2>
      <a href={base + '/contact'} class="inline-block mt-4 px-8 py-3 rounded-full font-medium text-sm" style="background: #C9A876; color: #1A2E4A;">
        <span data-lang="en">{finalCta.ctaPrimary.en}</span><span data-lang="id">{finalCta.ctaPrimary.id}</span>
      </a>
    </div>
  </section>
</BaseLayout>
