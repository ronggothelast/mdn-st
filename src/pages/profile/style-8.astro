---
// STYLE 08 — Community Story (photo-led narrative)
// Warm earthy palette, image-led storytelling.
import ProfileLayout from '../../layouts/ProfileLayout.astro';
import { brand, profile, services, team, stages, impactCards, kicker } from '../../data/content';
const base = import.meta.env.BASE_URL;
---
<ProfileLayout styleNum={8} styleName="Community Story">
  <div style="background: #F4ECDB; color: #1A2E4A; font-family: 'Fraunces', Georgia, serif;">
    <!-- Hero with full image -->
    <header class="relative min-h-screen flex items-center pt-32 pb-20 overflow-hidden">
      <img src={base + '/assets/images/hero-community.png'} alt="" class="absolute inset-0 w-full h-full object-cover" />
      <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(244,236,219,0.2) 0%, rgba(26,46,74,0.85) 100%);"></div>
      <div class="container-x relative max-w-5xl">
        <div class="text-xs font-sans uppercase tracking-[0.4em] mb-8" style="color: #C9A876;">
          <span data-lang="en">— A Madani Strategies Story</span>
          <span data-lang="id">— Sebuah Kisah Madani Strategies</span>
        </div>
        <h1 class="text-[clamp(3.5rem,9vw,8rem)] leading-[0.95] font-medium tracking-tight mb-12" style="color: #FAF6EC;">
          <span data-lang="en">For the people<br/>most affected.</span>
          <span data-lang="id">Untuk mereka<br/>yang paling terdampak.</span>
        </h1>
        <p class="text-2xl italic max-w-2xl" style="color: rgba(250,246,236,0.9);">
          <span data-lang="en">{brand.tagline.en}</span>
          <span data-lang="id">{brand.tagline.id}</span>
        </p>
      </div>
    </header>

    <!-- 1. Who We Are -->
    <section class="py-24 border-b border-[#C9A876]/40">
      <div class="container-x max-w-5xl">
        <div class="grid md:grid-cols-12 gap-12">
          <div class="md:col-span-4">
            <div class="text-xs font-sans uppercase tracking-[0.3em] mb-3" style="color: #3D8F8A;">— Chapter I</div>
            <h2 class="text-5xl leading-tight">
              <span data-lang="en">Who We Are</span>
              <span data-lang="id">Siapa Kami</span>
            </h2>
          </div>
          <div class="md:col-span-8 space-y-6">
            {profile.whoWeAre.body.en.map((p, i) => (
              <p class={`text-xl leading-[1.7] ${i === 0 ? 'dropcap' : ''}`}>
                <span data-lang="en">{p}</span>
                <span data-lang="id">{profile.whoWeAre.body.id[i]}</span>
              </p>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Photo + Who We Serve -->
    <section class="py-24 border-b border-[#C9A876]/40">
      <div class="container-x max-w-5xl">
        <div class="grid md:grid-cols-12 gap-12 items-center">
          <div class="md:col-span-6 order-2 md:order-1">
            <div class="aspect-[4/5] overflow-hidden rounded-lg">
              <img src={base + '/assets/images/service-trade.png'} alt="" class="w-full h-full object-cover" />
            </div>
          </div>
          <div class="md:col-span-6 order-1 md:order-2">
            <div class="text-xs font-sans uppercase tracking-[0.3em] mb-3" style="color: #3D8F8A;">— Chapter II</div>
            <h2 class="text-5xl mb-8 leading-tight">
              <span data-lang="en">Who We Serve</span>
              <span data-lang="id">Siapa yang Kami Layani</span>
            </h2>
            <p class="text-xl leading-[1.7]" style="color: #4A5568;">
              <span data-lang="en">{profile.whoWeServe.body.en}</span>
              <span data-lang="id">{profile.whoWeServe.body.id}</span>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. The Gap -->
    <section class="py-24 border-b border-[#C9A876]/40" style="background: #1A2E4A; color: #F4ECDB;">
      <div class="container-x max-w-4xl">
        <div class="text-xs font-sans uppercase tracking-[0.3em] mb-3" style="color: #C9A876;">— Chapter III</div>
        <h2 class="text-5xl mb-12 leading-tight">
          <span data-lang="en">{profile.theGap.title.en}</span>
          <span data-lang="id">{profile.theGap.title.id}</span>
        </h2>
        <div class="space-y-6">
          {profile.theGap.body.en.map((p, i) => (
            <p class="text-xl leading-[1.7]">
              <span data-lang="en">{p}</span>
              <span data-lang="id">{profile.theGap.body.id[i]}</span>
            </p>
          ))}
        </div>
      </div>
    </section>

    <!-- Pull quote between -->
    <section class="py-32 border-b border-[#C9A876]/40">
      <div class="container-x max-w-4xl text-center">
        <p class="text-3xl md:text-5xl italic leading-tight">
          <span class="block text-7xl mb-4" style="color: #C9A876;">&ldquo;</span>
          <span data-lang="en">Strategy without execution is theory. Execution without measurement is guesswork.</span>
          <span data-lang="id">Strategi tanpa eksekusi hanya teori. Eksekusi tanpa pengukuran hanya tebakan.</span>
        </p>
      </div>
    </section>

    <!-- 4. Approach -->
    <section class="py-24 border-b border-[#C9A876]/40">
      <div class="container-x max-w-5xl">
        <div class="text-xs font-sans uppercase tracking-[0.3em] mb-3" style="color: #3D8F8A;">— Chapter IV</div>
        <h2 class="text-5xl mb-16 leading-tight max-w-3xl">
          <span data-lang="en" set:html={kicker.approachTitle.en}></span>
          <span data-lang="id" set:html={kicker.approachTitle.id}></span>
        </h2>
        <div class="space-y-8">
          {stages.map((s, i) => (
            <div class="grid md:grid-cols-12 gap-8 pb-8 border-b border-[#C9A876]/30 last:border-0">
              <div class="md:col-span-2">
                <div class="text-7xl font-medium leading-none" style="color: #C9A876;">{s.num}</div>
              </div>
              <div class="md:col-span-10">
                <h3 class="text-3xl mb-4">
                  <span data-lang="en">{s.title.en}</span>
                  <span data-lang="id">{s.title.id}</span>
                </h3>
                <p class="text-lg leading-[1.7]" style="color: #4A5568;">
                  <span data-lang="en">{s.body.en}</span>
                  <span data-lang="id">{s.body.id}</span>
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 5. Services - photo + text per service -->
    <section class="py-24 border-b border-[#C9A876]/40">
      <div class="container-x max-w-5xl">
        <div class="text-xs font-sans uppercase tracking-[0.3em] mb-3" style="color: #3D8F8A;">— Chapter V</div>
        <h2 class="text-5xl mb-16 leading-tight">
          <span data-lang="en">Three Services</span>
          <span data-lang="id">Tiga Layanan</span>
        </h2>
        <div class="space-y-24">
          {services.map((svc, i) => (
            <article class={`grid md:grid-cols-12 gap-12 items-center ${i % 2 === 1 ? 'md:flex-row-reverse' : ''}`}>
              <div class={`md:col-span-5 ${i % 2 === 1 ? 'md:order-2' : ''}`}>
                <div class="aspect-[4/5] overflow-hidden rounded-lg">
                  <img src={svc.image} alt={svc.title.en} class="w-full h-full object-cover" />
                </div>
              </div>
              <div class={`md:col-span-7 ${i % 2 === 1 ? 'md:order-1' : ''}`}>
                <div class="text-xs font-sans uppercase tracking-[0.3em] mb-3" style="color: #C9A876;">Service {svc.num}</div>
                <h3 class="text-4xl mb-6 leading-tight">
                  <span data-lang="en">{svc.title.en}</span>
                  <span data-lang="id">{svc.title.id}</span>
                </h3>
                <div class="space-y-4">
                  {svc.detail.en.map((p, j) => (
                    <p class="text-lg leading-[1.7]" style="color: #4A5568;">
                      <span data-lang="en">{p}</span>
                      <span data-lang="id">{svc.detail.id[j]}</span>
                    </p>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. Impact -->
    <section class="py-24 border-b border-[#C9A876]/40" style="background: #FAF6EC;">
      <div class="container-x max-w-5xl">
        <div class="text-xs font-sans uppercase tracking-[0.3em] mb-3" style="color: #3D8F8A;">— Chapter VI</div>
        <h2 class="text-5xl mb-16 leading-tight">
          <span data-lang="en">Stories from the field</span>
          <span data-lang="id">Cerita dari lapangan</span>
        </h2>
        <div class="grid md:grid-cols-2 gap-12">
          {impactCards.map(c => (
            <div class="bg-white rounded-lg p-8">
              <div class="text-xs font-sans uppercase tracking-[0.3em] mb-3" style="color: #C9A876;">
                <span data-lang="en">{c.tag.en}</span>
                <span data-lang="id">{c.tag.id}</span>
              </div>
              <h3 class="text-2xl mb-4 leading-snug">
                <span data-lang="en">{c.title.en}</span>
                <span data-lang="id">{c.title.id}</span>
              </h3>
              <p class="text-base leading-[1.7]" style="color: #4A5568;">
                <span data-lang="en">{c.body.en}</span>
                <span data-lang="id">{c.body.id}</span>
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 7. Team -->
    <section class="py-24 border-b border-[#C9A876]/40">
      <div class="container-x max-w-5xl">
        <div class="text-xs font-sans uppercase tracking-[0.3em] mb-3" style="color: #3D8F8A;">— Chapter VII</div>
        <h2 class="text-5xl mb-16 leading-tight">
          <span data-lang="en">The people behind the work</span>
          <span data-lang="id">Orang-orang di balik kerja</span>
        </h2>
        <div class="grid md:grid-cols-2 gap-12">
          {team.map(m => (
            <div>
              <div class="aspect-[4/5] mb-6 overflow-hidden rounded-lg flex items-center justify-center text-7xl font-medium" style="background: linear-gradient(135deg, #3D8F8A, #1A2E4A); color: #F4ECDB;">{m.initials}</div>
              <h3 class="text-3xl mb-1">{m.name}</h3>
              <div class="text-xs font-sans uppercase tracking-[0.3em] mb-5" style="color: #3D8F8A;">
                <span data-lang="en">{m.role.en}</span>
                <span data-lang="id">{m.role.id}</span>
              </div>
              <p class="text-base leading-[1.7]" style="color: #4A5568;">
                <span data-lang="en">{m.bioFull.en}</span>
                <span data-lang="id">{m.bioFull.id}</span>
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 8. Closing -->
    <section class="py-32 text-center" style="background: #1A2E4A; color: #F4ECDB;">
      <div class="container-x max-w-3xl">
        <div class="text-xs font-sans uppercase tracking-[0.3em] mb-3" style="color: #C9A876;">— Chapter VIII</div>
        <h2 class="text-5xl mb-12 leading-tight">
          <span data-lang="en">{profile.whatComesNext.title.en}</span>
          <span data-lang="id">{profile.whatComesNext.title.id}</span>
        </h2>
        <div class="space-y-6 text-left mb-16">
          {profile.whatComesNext.body.en.map((p, i) => (
            <p class="text-xl italic leading-[1.7] text-[#FAF6EC]/85">
              <span data-lang="en">{p}</span>
              <span data-lang="id">{profile.whatComesNext.body.id[i]}</span>
            </p>
          ))}
        </div>
        <a href={`mailto:${brand.email}`} class="inline-block px-12 py-4 rounded-full font-sans" style="background: #C9A876; color: #1A2E4A;">{brand.email}</a>
      </div>
    </section>
  </div>
</ProfileLayout>
