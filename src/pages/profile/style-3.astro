---
// STYLE 03 — White Paper (Research Document)
// Print-friendly, serif-heavy, navy on cream paper.
import ProfileLayout from '../../layouts/ProfileLayout.astro';
import { brand, profile, services, team, stages, impactCards, kicker } from '../../data/content';
const base = import.meta.env.BASE_URL;
---
<ProfileLayout styleNum={3} styleName="White Paper">
  <div style="background: #FAF6EC; color: #1A2E4A; font-family: 'Fraunces', Georgia, serif;">
    <!-- Cover -->
    <section class="min-h-[80vh] flex flex-col justify-center py-24 border-b-2 border-[#1A2E4A]">
      <div class="container-x max-w-3xl">
        <div class="text-sm uppercase tracking-widest font-sans mb-12 pb-4 border-b border-[#1A2E4A]/30" style="color: #3D8F8A;">
          <span data-lang="en">A White Paper from Madani Strategies</span>
          <span data-lang="id">Makalah Putih dari Madani Strategies</span>
        </div>
        <h1 class="text-6xl md:text-7xl leading-[1.05] font-medium mb-12">
          <span data-lang="en">Connecting growth to community impact.</span>
          <span data-lang="id">Menghubungkan pertumbuhan ke dampak komunitas.</span>
        </h1>
        <p class="text-xl italic leading-[1.6] max-w-2xl" style="color: #4A5568;">
          <span data-lang="en">A consultancy positioned at the intersection of profit and accountability — a primer on our practice, methodology, and people.</span>
          <span data-lang="id">Sebuah konsultansi yang berdiri di persimpangan profit dan akuntabilitas — sebuah pengantar tentang praktik, metodologi, dan tim kami.</span>
        </p>
        <div class="mt-16 pt-8 border-t border-[#1A2E4A]/30 flex justify-between text-sm font-sans uppercase tracking-wider">
          <div>{brand.web}</div>
          <div>2026 · Vol. 01</div>
        </div>
      </div>
    </section>

    <!-- Abstract -->
    <section class="py-24 border-b border-[#1A2E4A]/20">
      <div class="container-x max-w-3xl">
        <div class="text-xs font-sans uppercase tracking-[0.3em] mb-4" style="color: #3D8F8A;">Abstract</div>
        <p class="text-2xl italic leading-[1.6]">
          <span data-lang="en">Madani Strategies advises organizations operating where growth meets community. We turn complex social and environmental challenges into clear strategic decisions, then execute alongside the people most affected.</span>
          <span data-lang="id">Madani Strategies menasihati organisasi yang beroperasi di titik temu antara pertumbuhan dan komunitas. Kami mengubah tantangan sosial dan lingkungan yang kompleks menjadi keputusan strategis yang jelas, lalu mengeksekusinya bersama orang-orang yang paling terdampak.</span>
        </p>
      </div>
    </section>

    <!-- 1. Introduction (Who We Are) -->
    <section class="py-24 border-b border-[#1A2E4A]/20">
      <div class="container-x max-w-3xl">
        <div class="text-xs font-sans uppercase tracking-[0.3em] mb-4" style="color: #3D8F8A;">§1 — Introduction</div>
        <h2 class="text-4xl mb-8">
          <span data-lang="en">{profile.whoWeAre.title.en}</span>
          <span data-lang="id">{profile.whoWeAre.title.id}</span>
        </h2>
        {profile.whoWeAre.body.en.map((p, i) => (
          <p class={`text-lg leading-[1.85] mb-6 ${i === 0 ? 'dropcap' : ''}`} style="text-align: justify;">
            <span data-lang="en">{p}</span>
            <span data-lang="id">{profile.whoWeAre.body.id[i]}</span>
          </p>
        ))}
      </div>
    </section>

    <!-- 2. Audience (Who We Serve) -->
    <section class="py-24 border-b border-[#1A2E4A]/20">
      <div class="container-x max-w-3xl">
        <div class="text-xs font-sans uppercase tracking-[0.3em] mb-4" style="color: #3D8F8A;">§2 — Intended Audience</div>
        <h2 class="text-4xl mb-8">
          <span data-lang="en">{profile.whoWeServe.title.en}</span>
          <span data-lang="id">{profile.whoWeServe.title.id}</span>
        </h2>
        <p class="text-lg leading-[1.85]" style="text-align: justify;">
          <span data-lang="en">{profile.whoWeServe.body.en}</span>
          <span data-lang="id">{profile.whoWeServe.body.id}</span>
        </p>
      </div>
    </section>

    <!-- 3. Problem Statement (The Gap) -->
    <section class="py-24 border-b border-[#1A2E4A]/20">
      <div class="container-x max-w-3xl">
        <div class="text-xs font-sans uppercase tracking-[0.3em] mb-4" style="color: #3D8F8A;">§3 — Problem Statement</div>
        <h2 class="text-4xl mb-8">
          <span data-lang="en">{profile.theGap.title.en}</span>
          <span data-lang="id">{profile.theGap.title.id}</span>
        </h2>
        {profile.theGap.body.en.map((p, i) => (
          <p class="text-lg leading-[1.85] mb-6" style="text-align: justify;">
            <span data-lang="en">{p}</span>
            <span data-lang="id">{profile.theGap.body.id[i]}</span>
          </p>
        ))}
      </div>
    </section>

    <!-- 4. Methodology -->
    <section class="py-24 border-b border-[#1A2E4A]/20">
      <div class="container-x max-w-3xl">
        <div class="text-xs font-sans uppercase tracking-[0.3em] mb-4" style="color: #3D8F8A;">§4 — Methodology</div>
        <h2 class="text-4xl mb-12">
          <span data-lang="en" set:html={kicker.approachTitle.en}></span>
          <span data-lang="id" set:html={kicker.approachTitle.id}></span>
        </h2>
        <ol class="space-y-8 list-none">
          {stages.map(s => (
            <li class="grid grid-cols-[auto_1fr] gap-6 pb-8 border-b border-[#1A2E4A]/15 last:border-0">
              <div class="text-3xl font-medium" style="color: #C9A876;">§4.{s.num}</div>
              <div>
                <h3 class="text-2xl mb-3"><span data-lang="en">{s.title.en}</span><span data-lang="id">{s.title.id}</span></h3>
                <p class="text-lg leading-[1.85]" style="text-align: justify;">
                  <span data-lang="en">{s.body.en}</span>
                  <span data-lang="id">{s.body.id}</span>
                </p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 5. Practice Areas (Services) -->
    <section class="py-24 border-b border-[#1A2E4A]/20">
      <div class="container-x max-w-3xl">
        <div class="text-xs font-sans uppercase tracking-[0.3em] mb-4" style="color: #3D8F8A;">§5 — Practice Areas</div>
        <h2 class="text-4xl mb-12">
          <span data-lang="en">Three integrated services</span>
          <span data-lang="id">Tiga layanan terintegrasi</span>
        </h2>
        <div class="space-y-12">
          {services.map(svc => (
            <div class="pb-12 border-b border-[#1A2E4A]/15 last:border-0">
              <div class="font-sans text-xs uppercase tracking-widest mb-3" style="color: #C9A876;">§5.{svc.num}</div>
              <h3 class="text-3xl mb-6 leading-tight">
                <span data-lang="en">{svc.title.en}</span>
                <span data-lang="id">{svc.title.id}</span>
              </h3>
              <div class="space-y-5">
                {svc.detail.en.map((p, j) => (
                  <p class="text-lg leading-[1.85]" style="text-align: justify;">
                    <span data-lang="en">{p}</span>
                    <span data-lang="id">{svc.detail.id[j]}</span>
                  </p>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. Case Studies -->
    <section class="py-24 border-b border-[#1A2E4A]/20" style="background: #F4ECDB;">
      <div class="container-x max-w-3xl">
        <div class="text-xs font-sans uppercase tracking-[0.3em] mb-4" style="color: #3D8F8A;">§6 — Case Studies</div>
        <h2 class="text-4xl mb-12">
          <span data-lang="en">Proof of execution</span>
          <span data-lang="id">Bukti eksekusi</span>
        </h2>
        <div class="space-y-10">
          {impactCards.map(c => (
            <article class="border-l-4 pl-6" style="border-color: #C9A876;">
              <div class="font-sans text-xs uppercase tracking-widest mb-3" style="color: #3D8F8A;">
                <span data-lang="en">{c.tag.en}</span>
                <span data-lang="id">{c.tag.id}</span>
              </div>
              <h3 class="text-2xl mb-3 leading-snug">
                <span data-lang="en">{c.title.en}</span>
                <span data-lang="id">{c.title.id}</span>
              </h3>
              <p class="text-lg leading-[1.7]" style="color: #4A5568;">
                <span data-lang="en">{c.body.en}</span>
                <span data-lang="id">{c.body.id}</span>
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 7. Authors (Team) -->
    <section class="py-24 border-b border-[#1A2E4A]/20">
      <div class="container-x max-w-3xl">
        <div class="text-xs font-sans uppercase tracking-[0.3em] mb-4" style="color: #3D8F8A;">§7 — Authors</div>
        <h2 class="text-4xl mb-12">
          <span data-lang="en">The team</span>
          <span data-lang="id">Tim kami</span>
        </h2>
        <div class="space-y-12">
          {team.map(m => (
            <div class="border-b border-[#1A2E4A]/15 pb-10 last:border-0">
              <h3 class="text-2xl mb-1">{m.name}</h3>
              <div class="font-sans text-xs uppercase tracking-widest mb-5" style="color: #3D8F8A;">
                <span data-lang="en">{m.role.en}</span>
                <span data-lang="id">{m.role.id}</span>
              </div>
              <p class="text-lg leading-[1.85]" style="text-align: justify; color: #4A5568;">
                <span data-lang="en">{m.bioFull.en}</span>
                <span data-lang="id">{m.bioFull.id}</span>
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 8. Conclusion -->
    <section class="py-32">
      <div class="container-x max-w-3xl">
        <div class="text-xs font-sans uppercase tracking-[0.3em] mb-4" style="color: #3D8F8A;">§8 — Conclusion</div>
        <h2 class="text-4xl mb-8">
          <span data-lang="en">{profile.whatComesNext.title.en}</span>
          <span data-lang="id">{profile.whatComesNext.title.id}</span>
        </h2>
        {profile.whatComesNext.body.en.map((p, i) => (
          <p class="text-lg leading-[1.85] mb-6" style="text-align: justify;">
            <span data-lang="en">{p}</span>
            <span data-lang="id">{profile.whatComesNext.body.id[i]}</span>
          </p>
        ))}
        <div class="mt-16 pt-8 border-t-2 border-[#1A2E4A]">
          <div class="font-sans text-xs uppercase tracking-[0.3em] mb-4" style="color: #3D8F8A;">Correspondence</div>
          <div class="text-lg">
            <div>{brand.email}</div>
            <div>{brand.phone}</div>
            <div class="mt-2">{brand.web}</div>
          </div>
        </div>
      </div>
    </section>
  </div>
</ProfileLayout>
