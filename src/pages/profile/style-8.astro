---
// STYLE 08 — Sanity Editorial Red
import ProfileLayout from '../../layouts/ProfileLayout.astro';
import { brand, profile, services, team } from '../../data/content';
const base = import.meta.env.BASE_URL;
---
<ProfileLayout styleNum={8} styleName="Sanity Red">
  <div style="background: #fff; color: #1A1A1A; font-family: 'Fraunces', Georgia, serif;">
    <section class="py-32 border-b border-black">
      <div class="container-x grid lg:grid-cols-[2fr_1fr] gap-16 items-end">
        <div>
          <div class="text-sm uppercase tracking-widest mb-6 font-sans" style="color: #F03E2F;">— Madani Quarterly · 2026</div>
          <h1 class="text-[clamp(4rem,10vw,9rem)] font-medium leading-[0.95] tracking-tight">{brand.name}</h1>
        </div>
        <div>
          <p class="text-2xl italic leading-snug">
            <span data-lang="en">{brand.tagline.en}</span>
            <span data-lang="id">{brand.tagline.id}</span>
          </p>
          <div class="mt-8 text-sm font-sans">{brand.email}</div>
        </div>
      </div>
    </section>

    <section class="py-24 border-b border-[#E5E5E5]">
      <div class="container-x grid lg:grid-cols-12 gap-8">
        <div class="lg:col-span-3">
          <div class="text-xs uppercase tracking-widest font-sans mb-2" style="color: #F03E2F;">Lead Story</div>
          <h2 class="text-3xl">
            <span data-lang="en">{profile.whoWeAre.title.en}</span>
            <span data-lang="id">{profile.whoWeAre.title.id}</span>
          </h2>
        </div>
        <div class="lg:col-span-9">
          <p class="dropcap text-lg leading-[1.7]">
            <span data-lang="en">{profile.whoWeAre.body.en[0]}</span>
            <span data-lang="id">{profile.whoWeAre.body.id[0]}</span>
          </p>
          <p class="text-lg leading-[1.7] mt-6">
            <span data-lang="en">{profile.whoWeAre.body.en[1]}</span>
            <span data-lang="id">{profile.whoWeAre.body.id[1]}</span>
          </p>
        </div>
      </div>
    </section>

    <section class="py-24 border-b border-[#E5E5E5]" style="background: #FFF1F0;">
      <div class="container-x">
        <div class="text-xs uppercase tracking-widest font-sans mb-3" style="color: #F03E2F;">Three Practices</div>
        <h2 class="text-4xl mb-16 max-w-3xl">
          <span data-lang="en">What we do, in detail.</span>
          <span data-lang="id">Apa yang kami lakukan, secara rinci.</span>
        </h2>
        <div class="grid md:grid-cols-3 gap-8">
          {services.map(svc => (
            <article class="bg-white p-8 border border-[#E5E5E5]">
              <div class="text-3xl mb-3" style="color: #F03E2F;">{svc.num}</div>
              <h3 class="text-2xl mb-4">
                <span data-lang="en">{svc.title.en}</span>
                <span data-lang="id">{svc.title.id}</span>
              </h3>
              <p class="text-base leading-relaxed">
                <span data-lang="en">{svc.short.en}</span>
                <span data-lang="id">{svc.short.id}</span>
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="py-24 border-b border-[#E5E5E5]">
      <div class="container-x">
        <div class="text-xs uppercase tracking-widest font-sans mb-3" style="color: #F03E2F;">Bylines</div>
        <h2 class="text-4xl mb-16">
          <span data-lang="en">The team</span>
          <span data-lang="id">Tim</span>
        </h2>
        <div class="grid md:grid-cols-2 gap-12">
          {team.map(m => (
            <div class="border-l-4 pl-6" style="border-color: #F03E2F;">
              <h3 class="text-2xl mb-2">{m.name}</h3>
              <div class="text-sm font-sans uppercase tracking-wider mb-4" style="color: #F03E2F;">
                <span data-lang="en">{m.role.en}</span>
                <span data-lang="id">{m.role.id}</span>
              </div>
              <p class="text-base leading-[1.7]">
                <span data-lang="en">{m.bioShort.en}</span>
                <span data-lang="id">{m.bioShort.id}</span>
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-24" style="background: #1A1A1A; color: white;">
      <div class="container-x text-center">
        <h2 class="text-5xl mb-8">
          <span data-lang="en">Continue the conversation.</span>
          <span data-lang="id">Lanjutkan percakapan.</span>
        </h2>
        <a href={`mailto:${brand.email}`} class="inline-block px-10 py-4 font-sans font-medium" style="background: #F03E2F; color: white;">{brand.email}</a>
      </div>
    </section>
  </div>
</ProfileLayout>
