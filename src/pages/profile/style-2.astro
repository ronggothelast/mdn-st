---
// STYLE 02 — Stripe Minimal
import ProfileLayout from '../../layouts/ProfileLayout.astro';
import { brand, profile, services, team, stages } from '../../data/content';
const base = import.meta.env.BASE_URL;
---
<ProfileLayout styleNum={2} styleName="Stripe Minimal">
  <div style="background: #FFFFFF; font-family: 'Inter', sans-serif; font-weight: 300; color: #1A1F36;">
    <!-- Hero with gradient -->
    <section class="relative overflow-hidden pt-40 pb-32" style="background: linear-gradient(135deg, #ffffff 0%, #f6f9fc 50%, #ede4ff 100%);">
      <div class="absolute -top-40 -right-40 w-[600px] h-[600px] rounded-full opacity-30" style="background: radial-gradient(circle, #635BFF, transparent 70%);"></div>
      <div class="container-x relative">
        <div class="max-w-3xl">
          <div class="text-sm font-medium tracking-wide mb-6" style="color: #635BFF;">
            <span data-lang="en">Strategic Impact Consultancy</span>
            <span data-lang="id">Konsultan Dampak Strategis</span>
          </div>
          <h1 class="text-7xl font-light leading-[1.05] mb-8 tracking-tight">{brand.name}</h1>
          <p class="text-3xl font-light leading-tight" style="color: #425466;">
            <span data-lang="en">{brand.tagline.en}</span>
            <span data-lang="id">{brand.tagline.id}</span>
          </p>
        </div>
      </div>
    </section>

    <!-- Who we are -->
    <section class="py-32">
      <div class="container-x grid lg:grid-cols-[1fr_2fr] gap-16">
        <div>
          <div class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: #635BFF;">01</div>
          <h2 class="text-4xl font-medium tracking-tight">
            <span data-lang="en">{profile.whoWeAre.title.en}</span>
            <span data-lang="id">{profile.whoWeAre.title.id}</span>
          </h2>
        </div>
        <div>
          {profile.whoWeAre.body.en.map((para, i) => (
            <p class="text-xl leading-relaxed mb-6" style="color: #425466;">
              <span data-lang="en">{para}</span>
              <span data-lang="id">{profile.whoWeAre.body.id[i]}</span>
            </p>
          ))}
        </div>
      </div>
    </section>

    <!-- Services as 3-col cards -->
    <section class="py-32 border-t border-[#e3e8ee]">
      <div class="container-x">
        <h2 class="text-4xl font-medium mb-16 max-w-2xl tracking-tight">
          <span data-lang="en">Three services. One integrated approach.</span>
          <span data-lang="id">Tiga layanan. Satu pendekatan terpadu.</span>
        </h2>
        <div class="grid md:grid-cols-3 gap-8">
          {services.map(svc => (
            <div class="p-1 rounded-2xl" style="background: linear-gradient(135deg, #635BFF, #00D4FF);">
              <div class="bg-white rounded-2xl p-8 h-full">
                <div class="text-sm font-semibold mb-2" style="color: #635BFF;">{svc.num}</div>
                <h3 class="text-2xl font-medium mb-4 tracking-tight">
                  <span data-lang="en">{svc.title.en}</span>
                  <span data-lang="id">{svc.title.id}</span>
                </h3>
                <p class="text-[#425466] leading-relaxed">
                  <span data-lang="en">{svc.short.en}</span>
                  <span data-lang="id">{svc.short.id}</span>
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Process -->
    <section class="py-32 border-t border-[#e3e8ee]">
      <div class="container-x grid lg:grid-cols-3 gap-12">
        {stages.map(s => (
          <div>
            <div class="text-6xl font-light mb-6" style="color: #635BFF;">0{s.num}</div>
            <h3 class="text-2xl font-medium mb-4 tracking-tight">
              <span data-lang="en">{s.title.en}</span>
              <span data-lang="id">{s.title.id}</span>
            </h3>
            <p class="text-[#425466] leading-relaxed">
              <span data-lang="en">{s.body.en}</span>
              <span data-lang="id">{s.body.id}</span>
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Team -->
    <section class="py-32 border-t border-[#e3e8ee]" style="background: #f6f9fc;">
      <div class="container-x">
        <h2 class="text-4xl font-medium mb-16 tracking-tight">
          <span data-lang="en">Our team</span>
          <span data-lang="id">Tim kami</span>
        </h2>
        <div class="grid md:grid-cols-2 gap-x-16 gap-y-12">
          {team.map(m => (
            <div>
              <h3 class="text-2xl font-medium mb-1">{m.name}</h3>
              <div class="text-sm font-medium mb-4" style="color: #635BFF;">
                <span data-lang="en">{m.role.en}</span>
                <span data-lang="id">{m.role.id}</span>
              </div>
              <p class="text-[#425466] leading-relaxed">
                <span data-lang="en">{m.bioShort.en}</span>
                <span data-lang="id">{m.bioShort.id}</span>
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-32 text-center">
      <div class="container-x max-w-2xl">
        <h2 class="text-5xl font-light mb-6 tracking-tight">
          <span data-lang="en">Reach out. Let's talk.</span>
          <span data-lang="id">Hubungi kami. Mari bicara.</span>
        </h2>
        <p class="text-xl text-[#425466] mb-10">{brand.email} · {brand.phone}</p>
      </div>
    </section>
  </div>
</ProfileLayout>
