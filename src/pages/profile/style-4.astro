---
// STYLE 04 — Notion Warm
import ProfileLayout from '../../layouts/ProfileLayout.astro';
import { brand, profile, services, team } from '../../data/content';
const base = import.meta.env.BASE_URL;
---
<ProfileLayout styleNum={4} styleName="Notion Warm">
  <div style="background: #FFFEFB; color: #37352F; font-family: 'Fraunces', Georgia, serif;">
    <section class="py-32">
      <div class="container-x max-w-3xl">
        <div class="text-7xl mb-2 opacity-90">📋</div>
        <h1 class="text-6xl font-semibold mb-4 tracking-tight">{brand.name}</h1>
        <p class="text-2xl text-[#787774] italic">
          <span data-lang="en">{brand.tagline.en}</span>
          <span data-lang="id">{brand.tagline.id}</span>
        </p>
      </div>
    </section>

    <article class="container-x max-w-3xl pb-32 space-y-16">
      <section>
        <h2 class="text-4xl font-semibold mb-6">
          <span data-lang="en">{profile.whoWeAre.title.en}</span>
          <span data-lang="id">{profile.whoWeAre.title.id}</span>
        </h2>
        {profile.whoWeAre.body.en.map((p, i) => (
          <p class="text-lg leading-[1.7] mb-5">
            <span data-lang="en">{p}</span>
            <span data-lang="id">{profile.whoWeAre.body.id[i]}</span>
          </p>
        ))}
      </section>

      <hr class="border-[#E9E9E7]" />

      <section>
        <h2 class="text-4xl font-semibold mb-6">
          <span data-lang="en">Three Services</span>
          <span data-lang="id">Tiga Layanan</span>
        </h2>
        <div class="space-y-8">
          {services.map(svc => (
            <div class="border-l-4 pl-6" style="border-color: #FFE9CC;">
              <div class="text-sm font-sans font-medium text-[#787774] mb-1">— Service {svc.num}</div>
              <h3 class="text-2xl font-semibold mb-3">
                <span data-lang="en">{svc.title.en}</span>
                <span data-lang="id">{svc.title.id}</span>
              </h3>
              <p class="text-lg leading-[1.7] text-[#37352F]">
                <span data-lang="en">{svc.detail.en[0]}</span>
                <span data-lang="id">{svc.detail.id[0]}</span>
              </p>
            </div>
          ))}
        </div>
      </section>

      <hr class="border-[#E9E9E7]" />

      <section>
        <h2 class="text-4xl font-semibold mb-6">
          <span data-lang="en">{profile.theGap.title.en}</span>
          <span data-lang="id">{profile.theGap.title.id}</span>
        </h2>
        <div class="rounded-lg p-6 mb-6" style="background: #FBF3DB;">
          <div class="font-sans text-xs uppercase tracking-wider text-[#7A6A40] mb-2">💡 Insight</div>
          <p class="text-lg italic leading-[1.6]">
            <span data-lang="en">The gap is in relevance. Most sustainability work treats social and environmental issues as compliance problems. They are business decisions.</span>
            <span data-lang="id">Celahnya ada di relevansi. Sebagian besar pekerjaan keberlanjutan memperlakukan isu sosial dan lingkungan sebagai masalah kepatuhan. Itu adalah keputusan bisnis.</span>
          </p>
        </div>
        {profile.theGap.body.en.map((p, i) => (
          <p class="text-lg leading-[1.7] mb-5">
            <span data-lang="en">{p}</span>
            <span data-lang="id">{profile.theGap.body.id[i]}</span>
          </p>
        ))}
      </section>

      <hr class="border-[#E9E9E7]" />

      <section>
        <h2 class="text-4xl font-semibold mb-6">
          <span data-lang="en">Our Team</span>
          <span data-lang="id">Tim Kami</span>
        </h2>
        <div class="space-y-6">
          {team.map(m => (
            <div class="flex gap-5 items-start">
              <div class="w-14 h-14 rounded-full flex items-center justify-center font-sans text-lg font-semibold flex-shrink-0" style="background: #FFE9CC; color: #7A6A40;">{m.initials}</div>
              <div>
                <h3 class="text-xl font-semibold">{m.name}</h3>
                <div class="text-sm font-sans text-[#787774] mb-2">
                  <span data-lang="en">{m.role.en}</span>
                  <span data-lang="id">{m.role.id}</span>
                </div>
                <p class="text-base leading-[1.6]">
                  <span data-lang="en">{m.bioShort.en}</span>
                  <span data-lang="id">{m.bioShort.id}</span>
                </p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <hr class="border-[#E9E9E7]" />

      <section>
        <h2 class="text-4xl font-semibold mb-6">
          <span data-lang="en">{profile.whatComesNext.title.en}</span>
          <span data-lang="id">{profile.whatComesNext.title.id}</span>
        </h2>
        {profile.whatComesNext.body.en.map((p, i) => (
          <p class="text-lg leading-[1.7] mb-4">
            <span data-lang="en">{p}</span>
            <span data-lang="id">{profile.whatComesNext.body.id[i]}</span>
          </p>
        ))}
        <div class="mt-8 font-sans text-sm">
          📧 {brand.email} · 📞 {brand.phone}
        </div>
      </section>
    </article>
  </div>
</ProfileLayout>
