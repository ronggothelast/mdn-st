---
import BaseLayout from '../layouts/BaseLayout.astro';
import { brand } from '../data/content';
---
<BaseLayout title="Contact">
  <section class="py-24 text-center" style="background: linear-gradient(180deg, #E8F2F1, #FDFCF8);">
    <div class="container-x">
      <span class="eyebrow"><span data-lang="en">Contact</span><span data-lang="id">Kontak</span></span>
      <h1 class="text-5xl mb-5">
        <span data-lang="en">Reach out. Let's talk.</span>
        <span data-lang="id">Hubungi kami. Mari bicara.</span>
      </h1>
      <p class="text-[#5C6B7E] text-lg max-w-2xl mx-auto">
        <span data-lang="en">We start with conversation. We listen to your specific challenges. We ask questions that clarify what actually matters.</span>
        <span data-lang="id">Kami mulai dengan percakapan. Kami mendengarkan tantangan spesifik Anda. Kami bertanya untuk memperjelas apa yang sebenarnya penting.</span>
      </p>
    </div>
  </section>

  <section class="py-20">
    <div class="container-x">
      <div class="grid md:grid-cols-3 gap-8 mb-16">
        <div class="text-center p-8 border border-[#E2E6EC] rounded-2xl bg-white">
          <h4 class="text-xs font-semibold tracking-[0.15em] uppercase text-[#3D8F8A] mb-3">
            <span data-lang="en">Email</span><span data-lang="id">Surel</span>
          </h4>
          <a href={`mailto:${brand.email}`} class="text-[#1A2E4A] hover:text-[#3D8F8A] transition-colors">{brand.email}</a>
        </div>
        <div class="text-center p-8 border border-[#E2E6EC] rounded-2xl bg-white">
          <h4 class="text-xs font-semibold tracking-[0.15em] uppercase text-[#3D8F8A] mb-3">
            <span data-lang="en">Phone</span><span data-lang="id">Telepon</span>
          </h4>
          <a href={`tel:${brand.phone.replace(/\s/g, '')}`} class="text-[#1A2E4A] hover:text-[#3D8F8A] transition-colors">{brand.phone}</a>
        </div>
        <div class="text-center p-8 border border-[#E2E6EC] rounded-2xl bg-white">
          <h4 class="text-xs font-semibold tracking-[0.15em] uppercase text-[#3D8F8A] mb-3">Web</h4>
          <span>{brand.web}</span>
        </div>
      </div>

      <form id="contact-form" class="grid gap-5 max-w-xl mx-auto">
        <input type="text" required placeholder="Your name" data-ph-en="Your name" data-ph-id="Nama Anda" class="px-5 py-3.5 border border-[#E2E6EC] rounded-xl bg-white focus:outline-none focus:border-[#3D8F8A] focus:ring-2 focus:ring-[#3D8F8A]/30" />
        <input type="email" required placeholder="Email address" data-ph-en="Email address" data-ph-id="Alamat email" class="px-5 py-3.5 border border-[#E2E6EC] rounded-xl bg-white focus:outline-none focus:border-[#3D8F8A] focus:ring-2 focus:ring-[#3D8F8A]/30" />
        <input type="text" placeholder="Organization (optional)" data-ph-en="Organization (optional)" data-ph-id="Organisasi (opsional)" class="px-5 py-3.5 border border-[#E2E6EC] rounded-xl bg-white focus:outline-none focus:border-[#3D8F8A] focus:ring-2 focus:ring-[#3D8F8A]/30" />
        <textarea required placeholder="Tell us about the decision you're navigating" data-ph-en="Tell us about the decision you're navigating" data-ph-id="Ceritakan keputusan yang sedang Anda navigasi" class="px-5 py-3.5 border border-[#E2E6EC] rounded-xl bg-white min-h-[140px] resize-y focus:outline-none focus:border-[#3D8F8A] focus:ring-2 focus:ring-[#3D8F8A]/30"></textarea>
        <button type="submit" class="bg-[#1A2E4A] hover:bg-[#0F1E33] text-white py-3.5 rounded-xl font-medium transition-colors">
          <span data-lang="en">Send message</span><span data-lang="id">Kirim pesan</span>
        </button>
      </form>
    </div>
  </section>

  <script is:inline>
    // Update placeholders on lang switch
    const updatePlaceholders = () => {
      const lang = document.documentElement.classList.contains('lang-id') ? 'id' : 'en';
      document.querySelectorAll('[data-ph-en]').forEach(el => {
        el.placeholder = el.getAttribute(`data-ph-${lang}`) || el.placeholder;
      });
    };
    updatePlaceholders();
    document.querySelectorAll('[data-lang-set]').forEach(b => b.addEventListener('click', () => setTimeout(updatePlaceholders, 10)));

    document.getElementById('contact-form').addEventListener('submit', e => {
      e.preventDefault();
      const lang = document.documentElement.classList.contains('lang-id') ? 'id' : 'en';
      const msg = lang === 'id' ? 'Terima kasih! Ini adalah prototipe.' : 'Thanks! This is a prototype.';
      alert(msg);
    });
  </script>
</BaseLayout>
