---
import BaseLayout from '../layouts/BaseLayout.astro';
import { impactCards, impactIntro, finalCta, brand } from '../data/content';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Impact">
  <!-- INTRO -->
  <section class="py-24" style="background: linear-gradient(180deg, #FAF6EC, #ffffff);">
    <div class="container-x max-w-4xl text-center">
      <span class="text-xs font-sans uppercase tracking-[0.3em]" style="color: #3D8F8A;">
        <span data-lang="en">{impactIntro.tag.en}</span><span data-lang="id">{impactIntro.tag.id}</span>
      </span>
      <h1 class="text-5xl md:text-6xl mt-4 mb-6 leading-tight" style="font-family: 'Fraunces', Georgia, serif;">
        <span data-lang="en">{impactIntro.headline.en}</span>
        <span data-lang="id">{impactIntro.headline.id}</span>
      </h1>
      <p class="text-lg leading-[1.7] max-w-2xl mx-auto" style="color: #4A5568;">
        <span data-lang="en">{impactIntro.body.en}</span>
        <span data-lang="id">{impactIntro.body.id}</span>
      </p>
    </div>
  </section>

  <!-- 4 IMPACT CARDS -->
  <section class="py-24">
    <div class="container-x max-w-5xl">
      <div class="grid md:grid-cols-2 gap-8">
        {impactCards.map(c => (
          <article class="p-8 rounded-3xl border" style="border-color: rgba(26,46,74,0.12); background: #FAF6EC;">
            <div class="text-xs font-sans uppercase tracking-[0.3em] mb-4" style="color: #C9A876;">
              <span data-lang="en">{c.tag.en}</span><span data-lang="id">{c.tag.id}</span>
            </div>
            <h3 class="text-3xl mb-5 leading-tight" style="font-family: 'Fraunces', Georgia, serif;">
              <span data-lang="en">{c.title.en}</span>
              <span data-lang="id">{c.title.id}</span>
            </h3>
            <p class="leading-[1.7]" style="color: #4A5568;">
              <span data-lang="en">{c.body.en}</span>
              <span data-lang="id">{c.body.id}</span>
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="py-24" style="background: #1A2E4A; color: #FAF6EC;">
    <div class="container-x max-w-4xl text-center">
      <span class="text-xs font-sans uppercase tracking-[0.3em]" style="color: #C9A876;">
        <span data-lang="en">{finalCta.tag.en}</span><span data-lang="id">{finalCta.tag.id}</span>
      </span>
      <h2 class="text-4xl md:text-5xl mt-4 mb-6 leading-tight" style="font-family: 'Fraunces', Georgia, serif;">
        <span data-lang="en">{finalCta.headline.en}</span>
        <span data-lang="id">{finalCta.headline.id}</span>
      </h2>
      <a href={base + '/contact'} class="inline-block mt-4 px-8 py-3 rounded-full font-medium text-sm" style="background: #C9A876; color: #1A2E4A;">
        <span data-lang="en">{finalCta.ctaPrimary.en}</span><span data-lang="id">{finalCta.ctaPrimary.id}</span>
      </a>
    </div>
  </section>
</BaseLayout>
