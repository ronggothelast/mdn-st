---
import BaseLayout from '../layouts/BaseLayout.astro';
import { team, profile } from '../data/content';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="About">
  <section class="py-24 text-center" style="background: linear-gradient(180deg, #E8F2F1, #FDFCF8);">
    <div class="container-x">
      <span class="eyebrow"><span data-lang="en">About</span><span data-lang="id">Tentang</span></span>
      <h1 class="text-5xl mb-5 max-w-3xl mx-auto">
        <span data-lang="en">Built on 20+ years of combined experience.</span>
        <span data-lang="id">Dibangun dari 20+ tahun pengalaman gabungan.</span>
      </h1>
      <p class="text-[#5C6B7E] text-lg max-w-2xl mx-auto">
        <span data-lang="en">Madani Strategies is a strategic impact consultancy grounded in environmental policy, sustainable development, community engagement, and strategic program management.</span>
        <span data-lang="id">Madani Strategies adalah konsultan dampak strategis yang berakar pada kebijakan lingkungan, pembangunan berkelanjutan, pelibatan komunitas, dan manajemen program strategis.</span>
      </p>
    </div>
  </section>

  <!-- Story -->
  <section class="py-20 bg-white">
    <div class="container-x grid lg:grid-cols-2 gap-16 items-center">
      <div class="rounded-3xl overflow-hidden aspect-[4/5]">
        <img src={base + '/assets/images/forest.png'} alt="Lush tropical forest" class="w-full h-full object-cover" />
      </div>
      <div>
        <span class="eyebrow"><span data-lang="en">Our Story</span><span data-lang="id">Cerita Kami</span></span>
        <h2 class="text-4xl mb-6">
          <span data-lang="en">{profile.theGap.title.en}</span>
          <span data-lang="id">{profile.theGap.title.id}</span>
        </h2>
        {profile.theGap.body.en.map((para, i) => (
          <p class={`text-[#5C6B7E] mb-5 text-base leading-relaxed ${i === 0 ? 'dropcap' : ''}`}>
            <span data-lang="en">{para}</span><span data-lang="id">{profile.theGap.body.id[i]}</span>
          </p>
        ))}
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="py-24" style="background: var(--color-tan-soft);">
    <div class="container-x">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="eyebrow"><span data-lang="en">Our Team</span><span data-lang="id">Tim Kami</span></span>
        <h2 class="text-4xl mb-4">
          <span data-lang="en">Practitioners, not just analysts.</span>
          <span data-lang="id">Praktisi, bukan sekadar analis.</span>
        </h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {team.map(m => (
          <div>
            <div class="aspect-square rounded-2xl overflow-hidden mb-4 relative" style="background: linear-gradient(135deg, var(--color-teal), var(--color-navy));">
              <div class="absolute inset-0" style="background: radial-gradient(circle at 50% 30%, rgba(255,255,255,0.15), transparent 60%);"></div>
              <div class="absolute inset-0 flex items-center justify-center">
                <span class="text-white font-serif text-5xl font-medium opacity-90">{m.initials}</span>
              </div>
            </div>
            <h4 class="text-lg font-semibold mb-1">{m.name}</h4>
            <div class="text-xs font-semibold uppercase tracking-wider text-[#3D8F8A] mb-2.5">
              <span data-lang="en">{m.role.en}</span><span data-lang="id">{m.role.id}</span>
            </div>
            <p class="text-sm text-[#5C6B7E] leading-relaxed">
              <span data-lang="en">{m.bioShort.en}</span><span data-lang="id">{m.bioShort.id}</span>
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
