---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { hero, stats, services, valueProp, valueCards, heroQuote, finalCta, brand } from '../data/content';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Home">
  <!-- HERO -->
  <section class="pt-20 pb-16" style="background: #1A2E4A; color: #FAF6EC;">
    <div class="container-x grid lg:grid-cols-[1.1fr_1fr] gap-12 items-center">
      <div>
        <span class="text-xs font-sans uppercase tracking-[0.3em]" style="color: #C9A876;">
          <span data-lang="en">{hero.eyebrow.en}</span><span data-lang="id">{hero.eyebrow.id}</span>
        </span>
        <h1 class="text-5xl md:text-6xl lg:text-7xl mt-5 leading-[1.05] tracking-tight" style="font-family: 'Fraunces', Georgia, serif;">
          <span data-lang="en">{hero.headline.en}</span>
          <span data-lang="id">{hero.headline.id}</span>
        </h1>
        <p class="text-lg leading-[1.7] mt-6 max-w-xl text-[#FAF6EC]/80">
          <span data-lang="en">{hero.subheadline.en}</span>
          <span data-lang="id">{hero.subheadline.id}</span>
        </p>
        <div class="mt-9 flex flex-wrap gap-4">
          <a href={base + '/contact'} class="inline-block px-7 py-3 rounded-full font-medium text-sm" style="background: #C9A876; color: #1A2E4A;">
            <span data-lang="en">{hero.ctaPrimary.en}</span><span data-lang="id">{hero.ctaPrimary.id}</span>
          </a>
          <a href={base + '/services'} class="inline-block px-7 py-3 rounded-full font-medium text-sm border border-[#FAF6EC]/30 hover:bg-[#FAF6EC]/10 transition">
            <span data-lang="en">{hero.ctaSecondary.en} →</span><span data-lang="id">{hero.ctaSecondary.id} →</span>
          </a>
        </div>
      </div>
      <div class="aspect-[4/5] rounded-3xl overflow-hidden">
        <img fetchpriority="high" loading="eager" decoding="async" src={base + '/assets/images/hero-community.webp'} alt="Community" class="w-full h-full object-cover" />
      </div>
    </div>
  </section>

  <!-- STATS STRIP -->
  <section class="py-12" style="background: #3D8F8A; color: #FAF6EC;">
    <div class="container-x grid grid-cols-2 md:grid-cols-3 gap-8">
      {stats.map(s => (
        <div class="text-center">
          <div class="text-5xl md:text-6xl font-medium" style="font-family: 'Fraunces', Georgia, serif;">{s.num}</div>
          <div class="text-xs uppercase tracking-widest mt-2 text-[#FAF6EC]/85">
            <span data-lang="en">{s.label.en}</span><span data-lang="id">{s.label.id}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- PULL QUOTE -->
  <section class="py-20 border-b border-[#1A2E4A]/10">
    <div class="container-x max-w-4xl text-center">
      <p class="text-2xl md:text-3xl italic leading-snug" style="font-family: 'Fraunces', Georgia, serif; color: #1A2E4A;">
        <span class="text-5xl align-top mr-2" style="color: #C9A876;">"</span>
        <span data-lang="en">{heroQuote.en}</span>
        <span data-lang="id">{heroQuote.id}</span>
      </p>
    </div>
  </section>

  <!-- WHY MAGIES (VALUE PROP) -->
  <section class="py-24" style="background: #FAF6EC;">
    <div class="container-x">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-sans uppercase tracking-[0.3em]" style="color: #3D8F8A;">
          <span data-lang="en">{valueProp.tag.en}</span><span data-lang="id">{valueProp.tag.id}</span>
        </span>
        <h2 class="text-4xl md:text-5xl mt-4 mb-6 leading-tight" style="font-family: 'Fraunces', Georgia, serif;">
          <span data-lang="en">{valueProp.headline.en}</span>
          <span data-lang="id">{valueProp.headline.id}</span>
        </h2>
        <p class="text-lg leading-[1.7]" style="color: #4A5568;">
          <span data-lang="en">{valueProp.body.en}</span>
          <span data-lang="id">{valueProp.body.id}</span>
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {valueCards.map((c, i) => (
          <div class="bg-white p-8 rounded-2xl border border-[#1A2E4A]/10">
            <div class="text-3xl font-medium mb-4" style="color: #C9A876; font-family: 'Fraunces', Georgia, serif;">0{i + 1}</div>
            <h3 class="text-xl mb-4 leading-tight" style="font-family: 'Fraunces', Georgia, serif;">
              <span data-lang="en">{c.title.en}</span>
              <span data-lang="id">{c.title.id}</span>
            </h3>
            <p class="leading-[1.7]" style="color: #4A5568;">
              <span data-lang="en">{c.body.en}</span>
              <span data-lang="id">{c.body.id}</span>
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SERVICES PREVIEW -->
  <section class="py-24">
    <div class="container-x">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-sans uppercase tracking-[0.3em]" style="color: #3D8F8A;">
          <span data-lang="en">What We Do</span><span data-lang="id">Layanan Kami</span>
        </span>
        <h2 class="text-4xl md:text-5xl mt-4 mb-6 leading-tight" style="font-family: 'Fraunces', Georgia, serif;">
          <span data-lang="en">Three integrated services. One coherent strategy.</span>
          <span data-lang="id">Tiga layanan terintegrasi. Satu strategi yang koheren.</span>
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {services.map(svc => (
          <ServiceCard
            num={svc.num}
            image={base + svc.image}
            titleEn={svc.title.en}
            titleId={svc.title.id}
            shortEn={svc.short.en}
            shortId={svc.short.id}
            href={base + '/services'}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="py-24" style="background: #1A2E4A; color: #FAF6EC;">
    <div class="container-x max-w-4xl text-center">
      <span class="text-xs font-sans uppercase tracking-[0.3em]" style="color: #C9A876;">
        <span data-lang="en">{finalCta.tag.en}</span><span data-lang="id">{finalCta.tag.id}</span>
      </span>
      <h2 class="text-4xl md:text-5xl mt-4 mb-6 leading-tight" style="font-family: 'Fraunces', Georgia, serif;">
        <span data-lang="en">{finalCta.headline.en}</span>
        <span data-lang="id">{finalCta.headline.id}</span>
      </h2>
      <p class="text-lg leading-[1.7] mb-10 text-[#FAF6EC]/85">
        <span data-lang="en">{finalCta.body.en}</span>
        <span data-lang="id">{finalCta.body.id}</span>
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href={base + '/contact'} class="inline-block px-8 py-3 rounded-full font-medium text-sm" style="background: #C9A876; color: #1A2E4A;">
          <span data-lang="en">{finalCta.ctaPrimary.en}</span><span data-lang="id">{finalCta.ctaPrimary.id}</span>
        </a>
        <a href={base + '/profile'} class="inline-block px-8 py-3 rounded-full font-medium text-sm border border-[#FAF6EC]/30 hover:bg-[#FAF6EC]/10 transition">
          <span data-lang="en">{finalCta.ctaSecondary.en}</span><span data-lang="id">{finalCta.ctaSecondary.id}</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
