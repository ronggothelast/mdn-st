---
// STYLE 05 — Apple Premium
import ProfileLayout from '../../layouts/ProfileLayout.astro';
import { brand, profile, services, team } from '../../data/content';
const base = import.meta.env.BASE_URL;
---
<ProfileLayout styleNum={5} styleName="Apple Premium">
  <div style="background: #FBFBFD; color: #1D1D1F; font-family: 'Inter', -apple-system, sans-serif; -webkit-font-smoothing: antialiased;">
    <!-- Massive hero -->
    <section class="min-h-[100vh] flex items-center pt-32 pb-24" style="background: linear-gradient(180deg, #fafafa 0%, #ffffff 100%);">
      <div class="container-x text-center max-w-5xl">
        <h1 class="text-[clamp(4rem,12vw,11rem)] font-semibold leading-[0.95] tracking-[-0.04em] mb-8">{brand.name}</h1>
        <p class="text-2xl md:text-4xl font-medium tracking-tight" style="color: #6E6E73;">
          <span data-lang="en">{brand.tagline.en}</span>
          <span data-lang="id">{brand.tagline.id}</span>
        </p>
      </div>
    </section>

    <!-- Massive image section -->
    <section class="py-24" style="background: #000;">
      <div class="container-x">
        <img src={base + '/assets/images/forest.png'} alt="Forest canopy" class="w-full rounded-2xl aspect-[16/9] object-cover" />
        <div class="text-center mt-12 text-white">
          <h2 class="text-4xl md:text-6xl font-semibold tracking-tight mb-6">
            <span data-lang="en">Built on evidence.</span>
            <span data-lang="id">Dibangun di atas bukti.</span>
          </h2>
          <p class="text-xl md:text-2xl max-w-2xl mx-auto" style="color: #A1A1A6;">
            <span data-lang="en">We do not start with frameworks. We start with questions that matter.</span>
            <span data-lang="id">Kami tidak mulai dari kerangka kerja. Kami mulai dari pertanyaan yang penting.</span>
          </p>
        </div>
      </div>
    </section>

    <!-- Big text -->
    <section class="py-32">
      <div class="container-x max-w-4xl">
        <h2 class="text-4xl md:text-6xl font-semibold tracking-tight leading-tight mb-8">
          <span data-lang="en">{profile.whoWeAre.title.en}.</span>
          <span data-lang="id">{profile.whoWeAre.title.id}.</span>
        </h2>
        {profile.whoWeAre.body.en.map((p, i) => (
          <p class="text-2xl leading-relaxed mb-6 font-medium" style="color: #6E6E73;">
            <span data-lang="en">{p}</span>
            <span data-lang="id">{profile.whoWeAre.body.id[i]}</span>
          </p>
        ))}
      </div>
    </section>

    <!-- Services as massive product cards -->
    <section class="space-y-6 pb-32 px-6">
      {services.map(svc => (
        <div class="rounded-3xl py-24 px-12 max-w-7xl mx-auto" style="background: #f5f5f7;">
          <div class="text-sm font-medium uppercase tracking-widest mb-4" style="color: #6E6E73;">{svc.num}</div>
          <h3 class="text-5xl md:text-6xl font-semibold tracking-tight mb-6 max-w-3xl">
            <span data-lang="en">{svc.title.en}</span>
            <span data-lang="id">{svc.title.id}</span>
          </h3>
          <p class="text-2xl max-w-3xl" style="color: #6E6E73;">
            <span data-lang="en">{svc.short.en}</span>
            <span data-lang="id">{svc.short.id}</span>
          </p>
        </div>
      ))}
    </section>

    <!-- Team -->
    <section class="py-32" style="background: #f5f5f7;">
      <div class="container-x max-w-6xl">
        <h2 class="text-5xl md:text-6xl font-semibold tracking-tight mb-16 text-center">
          <span data-lang="en">The team.</span>
          <span data-lang="id">Tim.</span>
        </h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          {team.map(m => (
            <div class="text-center">
              <div class="aspect-square rounded-3xl mb-4 flex items-center justify-center font-semibold text-4xl text-white" style="background: linear-gradient(135deg, #1A2E4A, #3D8F8A);">{m.initials}</div>
              <h3 class="text-xl font-semibold">{m.name}</h3>
              <div class="text-sm" style="color: #6E6E73;">
                <span data-lang="en">{m.role.en}</span>
                <span data-lang="id">{m.role.id}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-32 text-center">
      <h2 class="text-5xl md:text-7xl font-semibold tracking-tight mb-8">
        <span data-lang="en">Let's talk.</span>
        <span data-lang="id">Mari bicara.</span>
      </h2>
      <p class="text-2xl mb-12" style="color: #6E6E73;">{brand.email}</p>
    </section>
  </div>
</ProfileLayout>
