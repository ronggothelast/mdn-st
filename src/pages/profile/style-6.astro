---
// STYLE 06 — BMW Engineering
import ProfileLayout from '../../layouts/ProfileLayout.astro';
import { brand, profile, services, team, stages } from '../../data/content';
const base = import.meta.env.BASE_URL;
---
<ProfileLayout styleNum={6} styleName="BMW Engineering">
  <div style="background: #000; color: #fff; font-family: 'Inter', sans-serif;">
    <!-- M-stripe -->
    <div class="h-1 flex">
      <div class="flex-1" style="background: #1c69d4;"></div>
      <div class="flex-1" style="background: #2D2D2D;"></div>
      <div class="flex-1" style="background: #d40015;"></div>
    </div>

    <section class="py-32 relative overflow-hidden">
      <div class="absolute inset-0 opacity-20">
        <img src={base + '/assets/images/forest.png'} alt="" class="w-full h-full object-cover" />
      </div>
      <div class="absolute inset-0" style="background: linear-gradient(180deg, transparent 0%, #000 90%);"></div>
      <div class="container-x relative">
        <div class="text-xs font-mono uppercase tracking-[0.4em] text-white/60 mb-6">⌬ ENGINEERED FOR IMPACT</div>
        <h1 class="text-7xl md:text-9xl font-light leading-[0.95] tracking-tight mb-8 uppercase">{brand.name}</h1>
        <p class="text-2xl text-white/80 max-w-2xl uppercase tracking-wide">
          <span data-lang="en">{brand.tagline.en}</span>
          <span data-lang="id">{brand.tagline.id}</span>
        </p>
      </div>
    </section>

    <section class="py-24 border-t border-white/10">
      <div class="container-x">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-px" style="background: rgba(255,255,255,0.1);">
          <div class="p-8" style="background: #000;">
            <div class="text-xs uppercase tracking-wider text-white/60 mb-2">// 01</div>
            <div class="text-5xl font-light">20+</div>
            <div class="text-xs uppercase tracking-wider mt-2"><span data-lang="en">Years</span><span data-lang="id">Tahun</span></div>
          </div>
          <div class="p-8" style="background: #000;">
            <div class="text-xs uppercase tracking-wider text-white/60 mb-2">// 02</div>
            <div class="text-5xl font-light">3</div>
            <div class="text-xs uppercase tracking-wider mt-2"><span data-lang="en">Services</span><span data-lang="id">Layanan</span></div>
          </div>
          <div class="p-8" style="background: #000;">
            <div class="text-xs uppercase tracking-wider text-white/60 mb-2">// 03</div>
            <div class="text-5xl font-light">∞</div>
            <div class="text-xs uppercase tracking-wider mt-2"><span data-lang="en">Communities</span><span data-lang="id">Komunitas</span></div>
          </div>
          <div class="p-8" style="background: #000;">
            <div class="text-xs uppercase tracking-wider text-white/60 mb-2">// 04</div>
            <div class="text-5xl font-light">1</div>
            <div class="text-xs uppercase tracking-wider mt-2"><span data-lang="en">Mission</span><span data-lang="id">Misi</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-24 border-t border-white/10">
      <div class="container-x grid lg:grid-cols-[1fr_2fr] gap-12">
        <div>
          <div class="text-xs font-mono uppercase tracking-[0.3em] text-white/60 mb-4">/ SECTION 01</div>
          <h2 class="text-3xl uppercase tracking-tight">
            <span data-lang="en">{profile.whoWeAre.title.en}</span>
            <span data-lang="id">{profile.whoWeAre.title.id}</span>
          </h2>
          <div class="h-1 w-16 mt-6" style="background: linear-gradient(90deg, #1c69d4, #d40015);"></div>
        </div>
        <div>
          {profile.whoWeAre.body.en.map((p, i) => (
            <p class="text-lg leading-relaxed mb-6 text-white/80">
              <span data-lang="en">{p}</span>
              <span data-lang="id">{profile.whoWeAre.body.id[i]}</span>
            </p>
          ))}
        </div>
      </div>
    </section>

    <section class="py-24 border-t border-white/10">
      <div class="container-x">
        <div class="text-xs font-mono uppercase tracking-[0.3em] text-white/60 mb-4">/ SECTION 02 · CAPABILITIES</div>
        <h2 class="text-4xl uppercase tracking-tight mb-16">
          <span data-lang="en">Three engineering disciplines</span>
          <span data-lang="id">Tiga disiplin rekayasa</span>
        </h2>
        <div class="grid md:grid-cols-3 gap-px" style="background: rgba(255,255,255,0.1);">
          {services.map(svc => (
            <div class="p-10" style="background: #0a0a0a;">
              <div class="text-xs font-mono mb-4" style="color: #1c69d4;">{svc.num} //</div>
              <h3 class="text-2xl uppercase tracking-wide mb-4">
                <span data-lang="en">{svc.title.en}</span>
                <span data-lang="id">{svc.title.id}</span>
              </h3>
              <p class="text-white/70 leading-relaxed">
                <span data-lang="en">{svc.short.en}</span>
                <span data-lang="id">{svc.short.id}</span>
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-24 border-t border-white/10">
      <div class="container-x">
        <div class="text-xs font-mono uppercase tracking-[0.3em] text-white/60 mb-4">/ SECTION 03 · TEAM</div>
        <h2 class="text-4xl uppercase tracking-tight mb-16">
          <span data-lang="en">Engineers behind the work</span>
          <span data-lang="id">Insinyur di balik karya</span>
        </h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {team.map(m => (
            <div class="border border-white/10 p-6">
              <div class="text-xs font-mono mb-3" style="color: #1c69d4;">// MEMBER</div>
              <div class="aspect-square mb-4 flex items-center justify-center font-light text-4xl" style="background: linear-gradient(135deg, #1c69d4, #000); color: white;">{m.initials}</div>
              <h3 class="text-lg uppercase tracking-wide mb-1">{m.name}</h3>
              <div class="text-xs uppercase tracking-wider mb-3" style="color: #1c69d4;">
                <span data-lang="en">{m.role.en}</span>
                <span data-lang="id">{m.role.id}</span>
              </div>
              <p class="text-sm text-white/60 leading-relaxed">
                <span data-lang="en">{m.bioShort.en}</span>
                <span data-lang="id">{m.bioShort.id}</span>
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <div class="h-1 flex">
      <div class="flex-1" style="background: #1c69d4;"></div>
      <div class="flex-1" style="background: #2D2D2D;"></div>
      <div class="flex-1" style="background: #d40015;"></div>
    </div>

    <section class="py-24 text-center">
      <div class="container-x">
        <h2 class="text-5xl uppercase tracking-tight mb-6">
          <span data-lang="en">Let's engineer the next decision.</span>
          <span data-lang="id">Mari rekayasa keputusan berikutnya.</span>
        </h2>
        <a href={`mailto:${brand.email}`} class="inline-block px-12 py-4 font-medium tracking-wider uppercase text-sm" style="background: #1c69d4; color: white;">{brand.email}</a>
      </div>
    </section>
  </div>
</ProfileLayout>
