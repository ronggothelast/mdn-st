---
import BaseLayout from '../layouts/BaseLayout.astro';
import { brand, profile } from '../data/content';
const base = import.meta.env.BASE_URL;

const styles = [
  { id: 1,  name: 'Editorial Report',     desc: { en: 'Annual report formality with sectioned navy + cream layout.',  id: 'Format laporan tahunan, tata letak navy + krem yang berstruktur.' }, tag: { en: 'Formal', id: 'Formal' } },
  { id: 2,  name: 'Boutique Consulting',  desc: { en: 'Crisp McKinsey/Bain rigor — generous whitespace, structured.', id: 'Ketegasan McKinsey/Bain — banyak ruang putih, terstruktur.' },          tag: { en: 'Corporate', id: 'Korporat' } },
  { id: 3,  name: 'White Paper',          desc: { en: 'Research document with serif typography, justified text.',     id: 'Dokumen riset, tipografi serif, teks rata kanan-kiri.' },              tag: { en: 'Research', id: 'Riset' } },
  { id: 4,  name: 'Magazine Feature',     desc: { en: 'Editorial photography with drop caps and dual columns.',       id: 'Fotografi editorial dengan drop cap dan dua kolom.' },                  tag: { en: 'Editorial', id: 'Editorial' } },
  { id: 5,  name: 'Sustainability Brief', desc: { en: 'Foundation-style impact brief with stat cards & flow.',        id: 'Brief dampak gaya foundation, kartu statistik dan alur.' },             tag: { en: 'Impact', id: 'Dampak' } },
  { id: 6,  name: 'Heritage Document',    desc: { en: 'Classical Indonesian elegance with ornamental separators.',    id: 'Keanggunan klasik Indonesia dengan pemisah ornamental.' },              tag: { en: 'Classical', id: 'Klasik' } },
  { id: 7,  name: 'Modern Foundation',    desc: { en: 'Philanthropy-style with generous photography & navy.',         id: 'Gaya filantropi dengan fotografi besar dan navy.' },                    tag: { en: 'Modern', id: 'Modern' } },
  { id: 8,  name: 'Community Story',      desc: { en: 'Photo-led narrative storytelling, warm earthy palette.',       id: 'Cerita berbasis foto, palet hangat dan natural.' },                     tag: { en: 'Narrative', id: 'Naratif' } },
  { id: 9,  name: 'Strategic Brief',      desc: { en: 'Pitch-deck inspired with dense info on deep navy.',            id: 'Terinspirasi pitch deck, info padat pada navy gelap.' },                tag: { en: 'Executive', id: 'Eksekutif' } },
  { id: 10, name: 'Premium Folio',        desc: { en: 'Coffee-table book elegance with large imagery & gold.',        id: 'Keanggunan buku coffee-table, gambar besar dan aksen emas.' },          tag: { en: 'Premium', id: 'Premium' } },
];
---
<BaseLayout title="Company Profile">
  <section class="py-24 text-center" style="background: linear-gradient(180deg, #E8F2F1, #FDFCF8);">
    <div class="container-x">
      <span class="eyebrow"><span data-lang="en">Company Profile</span><span data-lang="id">Profil Perusahaan</span></span>
      <h1 class="text-5xl md:text-6xl mb-4">{brand.name}</h1>
      <p class="font-serif italic text-2xl mb-2" style="color: var(--color-teal);">
        <span data-lang="en">{brand.tagline.en}</span>
        <span data-lang="id">{brand.tagline.id}</span>
      </p>
      <p class="text-[#5C6B7E] mt-6 max-w-2xl mx-auto">
        <span data-lang="en">Choose the design direction that feels right. Same content — ten distinct visual languages.</span>
        <span data-lang="id">Pilih arah desain yang paling pas. Konten sama — sepuluh bahasa visual berbeda.</span>
      </p>
    </div>
  </section>

  <!-- Style picker -->
  <section class="py-12">
    <div class="container-x">
      <div class="flex items-center justify-center gap-3 mb-12 flex-wrap">
        <a href={`${base}/styleguide`} class="px-5 py-2.5 bg-[#1A2E4A] text-white text-sm font-semibold rounded-full hover:bg-[#3D8F8A] transition-colors shadow-md">
          <span data-lang="en">View All Design Systems</span>
          <span data-lang="id">Lihat Semua Sistem Desain</span>
        </a>
        <span class="text-[#E2E6EC] mx-2">|</span>
        <label for="style-picker" class="text-sm font-semibold text-[#5C6B7E]">
          <span data-lang="en">Jump to style:</span><span data-lang="id">Lompat ke gaya:</span>
        </label>
        <select id="style-picker" class="px-4 py-2.5 border border-[#E2E6EC] rounded-full bg-white font-medium focus:outline-none focus:border-[#3D8F8A]">
          <option value="">— pick a style —</option>
          {styles.map(s => <option value={s.id}>{`Style ${String(s.id).padStart(2, '0')} · ${s.name}`}</option>)}
        </select>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        {styles.map(s => (
          <div class="group bg-white border border-[#E2E6EC] rounded-2xl p-6 hover:-translate-y-1 hover:shadow-xl hover:border-[#3D8F8A] transition-all flex flex-col">
            <a href={`${base}/profile/style-${s.id}`} class="block">
              <div class="aspect-[4/3] rounded-lg mb-5 overflow-hidden flex items-center justify-center font-serif text-3xl font-semibold text-white relative" style="background: linear-gradient(135deg, var(--color-navy), var(--color-teal));">
                <span class="opacity-90">{String(s.id).padStart(2, '0')}</span>
                <div class="absolute bottom-3 right-3 text-[0.62rem] font-sans uppercase tracking-wider opacity-70">Madani</div>
              </div>
              <div class="text-[0.7rem] font-semibold tracking-wider uppercase text-[#3D8F8A] mb-1.5">Style {String(s.id).padStart(2, '0')}</div>
              <h3 class="font-semibold text-lg mb-2 group-hover:text-[#3D8F8A] transition-colors">{s.name}</h3>
              <p class="text-sm text-[#5C6B7E] leading-relaxed">
                <span data-lang="en">{s.desc.en}</span>
                <span data-lang="id">{s.desc.id}</span>
              </p>
            </a>
            <div class="mt-4 pt-4 border-t border-[#E2E6EC] flex items-center justify-between gap-3">
              <a href={`${base}/profile/style-${s.id}`} class="text-sm font-semibold text-[#1A2E4A] flex items-center gap-1.5 hover:text-[#3D8F8A] transition-colors">
                <span data-lang="en">View profile</span><span data-lang="id">Lihat profil</span>
                <span aria-hidden="true">→</span>
              </a>
              <a href={`${base}/styleguide/${s.id}`} class="text-xs font-semibold uppercase tracking-wider text-[#3D8F8A] hover:text-[#1A2E4A] transition-colors" title="View design system">
                <span data-lang="en">System</span><span data-lang="id">Sistem</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ base }}>
    document.getElementById('style-picker').addEventListener('change', e => {
      const v = e.target.value;
      if (v) window.location.href = `${base}/profile/style-${v}`;
    });
  </script>
</BaseLayout>
