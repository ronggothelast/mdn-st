---
// STYLE 02 — Boutique Consulting (Bain/McKinsey vibe)
// Crisp navy, generous whitespace, structured rigor.
import ProfileLayout from '../../layouts/ProfileLayout.astro';
import { brand, profile, services, team, stages, impactCards, kicker } from '../../data/content';
const base = import.meta.env.BASE_URL;
---
<ProfileLayout styleNum={2} styleName="Boutique Consulting">
  <div style="background: #FFFFFF; color: #1A2E4A; font-family: 'Inter', sans-serif;">
    <!-- Hero -->
    <section class="py-32 border-b border-[#1A2E4A]/15">
      <div class="container-x max-w-6xl">
        <div class="text-xs uppercase tracking-[0.3em] mb-12" style="color: #3D8F8A;">
          <span data-lang="en">Strategic Impact Consultancy · Est. 2026</span>
          <span data-lang="id">Konsultan Dampak Strategis · Est. 2026</span>
        </div>
        <h1 class="text-[clamp(3rem,7vw,6rem)] font-medium leading-[1.05] tracking-tight mb-12 max-w-4xl" style="font-family: 'Fraunces', Georgia, serif;">{brand.name}</h1>
        <p class="text-2xl max-w-2xl leading-snug" style="color: #4A5568;">
          <span data-lang="en">{brand.tagline.en}</span>
          <span data-lang="id">{brand.tagline.id}</span>
        </p>
      </div>
    </section>

    <!-- 1. Who We Are -->
    <section class="py-24 border-b border-[#1A2E4A]/15">
      <div class="container-x max-w-6xl grid md:grid-cols-12 gap-8">
        <div class="md:col-span-3">
          <div class="text-xs uppercase tracking-[0.3em] sticky top-24" style="color: #3D8F8A;">01 / Identity</div>
        </div>
        <div class="md:col-span-9">
          <h2 class="text-4xl font-medium mb-10" style="font-family: 'Fraunces', Georgia, serif;">
            <span data-lang="en">{profile.whoWeAre.title.en}</span>
            <span data-lang="id">{profile.whoWeAre.title.id}</span>
          </h2>
          <div class="space-y-6 max-w-3xl">
            {profile.whoWeAre.body.en.map((p, i) => (
              <p class="text-xl leading-[1.7]" style="color: #4A5568;">
                <span data-lang="en">{p}</span>
                <span data-lang="id">{profile.whoWeAre.body.id[i]}</span>
              </p>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Who We Serve -->
    <section class="py-24 border-b border-[#1A2E4A]/15">
      <div class="container-x max-w-6xl grid md:grid-cols-12 gap-8">
        <div class="md:col-span-3">
          <div class="text-xs uppercase tracking-[0.3em] sticky top-24" style="color: #3D8F8A;">02 / Clients</div>
        </div>
        <div class="md:col-span-9">
          <h2 class="text-4xl font-medium mb-10" style="font-family: 'Fraunces', Georgia, serif;">
            <span data-lang="en">{profile.whoWeServe.title.en}</span>
            <span data-lang="id">{profile.whoWeServe.title.id}</span>
          </h2>
          <p class="text-xl leading-[1.7] max-w-3xl" style="color: #4A5568;">
            <span data-lang="en">{profile.whoWeServe.body.en}</span>
            <span data-lang="id">{profile.whoWeServe.body.id}</span>
          </p>
        </div>
      </div>
    </section>

    <!-- 3. The Gap -->
    <section class="py-24 border-b border-[#1A2E4A]/15">
      <div class="container-x max-w-6xl grid md:grid-cols-12 gap-8">
        <div class="md:col-span-3">
          <div class="text-xs uppercase tracking-[0.3em] sticky top-24" style="color: #3D8F8A;">03 / Thesis</div>
        </div>
        <div class="md:col-span-9">
          <h2 class="text-4xl font-medium mb-10" style="font-family: 'Fraunces', Georgia, serif;">
            <span data-lang="en">{profile.theGap.title.en}</span>
            <span data-lang="id">{profile.theGap.title.id}</span>
          </h2>
          <div class="space-y-6 max-w-3xl">
            {profile.theGap.body.en.map((p, i) => (
              <p class="text-xl leading-[1.7]" style="color: #4A5568;">
                <span data-lang="en">{p}</span>
                <span data-lang="id">{profile.theGap.body.id[i]}</span>
              </p>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Approach -->
    <section class="py-24 border-b border-[#1A2E4A]/15" style="background: #FAF6EC;">
      <div class="container-x max-w-6xl">
        <div class="grid md:grid-cols-12 gap-8 mb-16">
          <div class="md:col-span-3">
            <div class="text-xs uppercase tracking-[0.3em]" style="color: #3D8F8A;">04 / Methodology</div>
          </div>
          <div class="md:col-span-9">
            <h2 class="text-4xl font-medium leading-snug max-w-3xl" style="font-family: 'Fraunces', Georgia, serif;">
              <span data-lang="en" set:html={kicker.approachTitle.en}></span>
              <span data-lang="id" set:html={kicker.approachTitle.id}></span>
            </h2>
          </div>
        </div>
        <div class="grid md:grid-cols-3 gap-12">
          {stages.map(s => (
            <div>
              <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-full flex items-center justify-center font-medium text-sm" style="background: #1A2E4A; color: white;">{s.num}</div>
                <h3 class="text-xl font-medium" style="font-family: 'Fraunces', Georgia, serif;">
                  <span data-lang="en">{s.title.en}</span>
                  <span data-lang="id">{s.title.id}</span>
                </h3>
              </div>
              <p class="text-base leading-[1.7]" style="color: #4A5568;">
                <span data-lang="en">{s.body.en}</span>
                <span data-lang="id">{s.body.id}</span>
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 5. Services -->
    <section class="py-24 border-b border-[#1A2E4A]/15">
      <div class="container-x max-w-6xl">
        <div class="grid md:grid-cols-12 gap-8 mb-16">
          <div class="md:col-span-3">
            <div class="text-xs uppercase tracking-[0.3em]" style="color: #3D8F8A;">05 / Services</div>
          </div>
          <div class="md:col-span-9">
            <h2 class="text-4xl font-medium" style="font-family: 'Fraunces', Georgia, serif;">
              <span data-lang="en">Three integrated services.</span>
              <span data-lang="id">Tiga layanan terintegrasi.</span>
            </h2>
          </div>
        </div>
        <div class="space-y-16">
          {services.map(svc => (
            <div class="grid md:grid-cols-12 gap-8 pb-12 border-b border-[#1A2E4A]/15 last:border-0">
              <div class="md:col-span-3">
                <div class="text-sm font-medium mb-2" style="color: #3D8F8A;">Service {svc.num}</div>
                <h3 class="text-2xl font-medium leading-tight" style="font-family: 'Fraunces', Georgia, serif;">
                  <span data-lang="en">{svc.title.en}</span>
                  <span data-lang="id">{svc.title.id}</span>
                </h3>
              </div>
              <div class="md:col-span-9 space-y-5">
                {svc.detail.en.map((p, j) => (
                  <p class="text-lg leading-[1.7]" style="color: #4A5568;">
                    <span data-lang="en">{p}</span>
                    <span data-lang="id">{svc.detail.id[j]}</span>
                  </p>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. Impact -->
    <section class="py-24 border-b border-[#1A2E4A]/15">
      <div class="container-x max-w-6xl">
        <div class="grid md:grid-cols-12 gap-8 mb-16">
          <div class="md:col-span-3">
            <div class="text-xs uppercase tracking-[0.3em]" style="color: #3D8F8A;">06 / Evidence</div>
          </div>
          <div class="md:col-span-9">
            <h2 class="text-4xl font-medium" style="font-family: 'Fraunces', Georgia, serif;">
              <span data-lang="en">Proof of execution.</span>
              <span data-lang="id">Bukti eksekusi.</span>
            </h2>
          </div>
        </div>
        <div class="grid md:grid-cols-2 gap-x-12 gap-y-12">
          {impactCards.map(c => (
            <div class="border-t pt-5" style="border-color: #3D8F8A;">
              <div class="text-xs uppercase tracking-[0.2em] mb-3" style="color: #3D8F8A;">
                <span data-lang="en">{c.tag.en}</span>
                <span data-lang="id">{c.tag.id}</span>
              </div>
              <h3 class="text-xl mb-3 leading-snug" style="font-family: 'Fraunces', Georgia, serif;">
                <span data-lang="en">{c.title.en}</span>
                <span data-lang="id">{c.title.id}</span>
              </h3>
              <p class="text-base leading-[1.6]" style="color: #4A5568;">
                <span data-lang="en">{c.body.en}</span>
                <span data-lang="id">{c.body.id}</span>
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 7. Team -->
    <section class="py-24 border-b border-[#1A2E4A]/15">
      <div class="container-x max-w-6xl">
        <div class="grid md:grid-cols-12 gap-8 mb-16">
          <div class="md:col-span-3">
            <div class="text-xs uppercase tracking-[0.3em]" style="color: #3D8F8A;">07 / People</div>
          </div>
          <div class="md:col-span-9">
            <h2 class="text-4xl font-medium" style="font-family: 'Fraunces', Georgia, serif;">
              <span data-lang="en">Practitioners, not analysts.</span>
              <span data-lang="id">Praktisi, bukan analis.</span>
            </h2>
          </div>
        </div>
        <div class="grid md:grid-cols-2 gap-12">
          {team.map(m => (
            <div class="grid grid-cols-[auto_1fr] gap-6">
              <div class="w-20 h-20 rounded-full flex items-center justify-center text-2xl font-medium" style="background: #1A2E4A; color: white; font-family: 'Fraunces', Georgia, serif;">{m.initials}</div>
              <div>
                <h3 class="text-2xl mb-1 leading-tight" style="font-family: 'Fraunces', Georgia, serif;">{m.name}</h3>
                <div class="text-xs uppercase tracking-[0.2em] mb-4" style="color: #3D8F8A;">
                  <span data-lang="en">{m.role.en}</span>
                  <span data-lang="id">{m.role.id}</span>
                </div>
                <p class="text-base leading-[1.7]" style="color: #4A5568;">
                  <span data-lang="en">{m.bioFull.en}</span>
                  <span data-lang="id">{m.bioFull.id}</span>
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 8. Closing -->
    <section class="py-32" style="background: #1A2E4A; color: white;">
      <div class="container-x max-w-4xl">
        <div class="text-xs uppercase tracking-[0.3em] mb-12" style="color: #5BAFA9;">08 / Engagement</div>
        <h2 class="text-5xl font-medium mb-12" style="font-family: 'Fraunces', Georgia, serif;">
          <span data-lang="en">{profile.whatComesNext.title.en}</span>
          <span data-lang="id">{profile.whatComesNext.title.id}</span>
        </h2>
        <div class="space-y-6 mb-16">
          {profile.whatComesNext.body.en.map((p, i) => (
            <p class="text-xl leading-[1.7] text-white/85">
              <span data-lang="en">{p}</span>
              <span data-lang="id">{profile.whatComesNext.body.id[i]}</span>
            </p>
          ))}
        </div>
        <div class="pt-12 border-t border-white/15 grid md:grid-cols-2 gap-8">
          <div>
            <div class="text-xs uppercase tracking-[0.3em] mb-2" style="color: #5BAFA9;">Email</div>
            <a href={`mailto:${brand.email}`} class="text-xl">{brand.email}</a>
          </div>
          <div>
            <div class="text-xs uppercase tracking-[0.3em] mb-2" style="color: #5BAFA9;">Phone</div>
            <div class="text-xl">{brand.phone}</div>
          </div>
        </div>
      </div>
    </section>
  </div>
</ProfileLayout>
