---
// STYLE 03 — Linear Dark
import ProfileLayout from '../../layouts/ProfileLayout.astro';
import { brand, profile, services, team } from '../../data/content';
const base = import.meta.env.BASE_URL;
---
<ProfileLayout styleNum={3} styleName="Linear Dark">
  <div style="background: #08090A; color: #F7F8F8; font-family: 'Inter', sans-serif; min-height: 100vh;">
    <section class="py-40">
      <div class="container-x max-w-5xl">
        <div class="font-mono text-xs uppercase tracking-[0.3em] mb-8" style="color: #5E6AD2;">// company-profile-2026</div>
        <h1 class="text-7xl md:text-8xl font-medium tracking-tight mb-8">{brand.name}</h1>
        <p class="text-2xl mb-12 max-w-2xl" style="color: #B4BCD0;">
          <span data-lang="en">{brand.tagline.en}</span>
          <span data-lang="id">{brand.tagline.id}</span>
        </p>
        <div class="font-mono text-sm grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl">
          <div><div class="opacity-50 mb-1">EMAIL</div><div>{brand.email}</div></div>
          <div><div class="opacity-50 mb-1">PHONE</div><div>{brand.phone}</div></div>
          <div><div class="opacity-50 mb-1">FOCUS</div><div>SUSTAIN.</div></div>
          <div><div class="opacity-50 mb-1">SINCE</div><div>2026</div></div>
        </div>
      </div>
    </section>

    <section class="py-24 border-t" style="border-color: #1F2125;">
      <div class="container-x grid lg:grid-cols-[1fr_2fr] gap-16">
        <div>
          <div class="font-mono text-xs uppercase tracking-[0.3em] mb-3" style="color: #5E6AD2;">01 / WHO</div>
          <h2 class="text-3xl font-medium">
            <span data-lang="en">{profile.whoWeAre.title.en}</span>
            <span data-lang="id">{profile.whoWeAre.title.id}</span>
          </h2>
        </div>
        <div>
          {profile.whoWeAre.body.en.map((p, i) => (
            <p class="text-lg leading-relaxed mb-6" style="color: #B4BCD0;">
              <span data-lang="en">{p}</span>
              <span data-lang="id">{profile.whoWeAre.body.id[i]}</span>
            </p>
          ))}
        </div>
      </div>
    </section>

    <section class="py-24 border-t" style="border-color: #1F2125;">
      <div class="container-x">
        <div class="font-mono text-xs uppercase tracking-[0.3em] mb-12" style="color: #5E6AD2;">02 / SERVICES</div>
        <div class="grid md:grid-cols-3 gap-px" style="background: #1F2125;">
          {services.map(svc => (
            <div class="p-8" style="background: #0E1011;">
              <div class="font-mono text-sm mb-3" style="color: #5E6AD2;">{svc.num}</div>
              <h3 class="text-xl mb-4 font-medium">
                <span data-lang="en">{svc.title.en}</span>
                <span data-lang="id">{svc.title.id}</span>
              </h3>
              <p class="text-sm leading-relaxed" style="color: #B4BCD0;">
                <span data-lang="en">{svc.short.en}</span>
                <span data-lang="id">{svc.short.id}</span>
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-24 border-t" style="border-color: #1F2125;">
      <div class="container-x">
        <div class="font-mono text-xs uppercase tracking-[0.3em] mb-12" style="color: #5E6AD2;">03 / TEAM</div>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          {team.map(m => (
            <div>
              <div class="aspect-square rounded mb-4 flex items-center justify-center font-mono text-3xl font-light" style="background: #16181C; color: #5E6AD2;">{m.initials}</div>
              <h3 class="font-medium">{m.name}</h3>
              <div class="text-xs font-mono opacity-60 mb-3 uppercase tracking-wider">
                <span data-lang="en">{m.role.en}</span>
                <span data-lang="id">{m.role.id}</span>
              </div>
              <p class="text-sm" style="color: #B4BCD0;">
                <span data-lang="en">{m.bioShort.en}</span>
                <span data-lang="id">{m.bioShort.id}</span>
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-32 border-t" style="border-color: #1F2125;">
      <div class="container-x max-w-3xl text-center">
        <div class="font-mono text-xs uppercase tracking-[0.3em] mb-6" style="color: #5E6AD2;">// next</div>
        <h2 class="text-5xl font-medium mb-8">
          <span data-lang="en">Reach out. Let's talk.</span>
          <span data-lang="id">Hubungi kami. Mari bicara.</span>
        </h2>
        <a href={`mailto:${brand.email}`} class="inline-block px-8 py-4 rounded-lg font-medium transition-opacity hover:opacity-80" style="background: #5E6AD2; color: white;">{brand.email}</a>
      </div>
    </section>
  </div>
</ProfileLayout>
