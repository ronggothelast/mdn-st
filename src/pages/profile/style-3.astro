---
// STYLE 03 — Linear Dark
import ProfileLayout from '../../layouts/ProfileLayout.astro';
import { brand, profile, services, team, stages, impactCards, kicker } from '../../data/content';
const base = import.meta.env.BASE_URL;
---
<ProfileLayout styleNum={3} styleName="Linear Dark">
  <div style="background: #08090A; color: #F7F8F8; font-family: 'Inter', sans-serif; min-height: 100vh;">
    <!-- Hero -->
    <section class="py-40 border-b border-[#1F2125]">
      <div class="container-x max-w-4xl">
        <div class="font-mono text-xs uppercase tracking-[0.3em] mb-8" style="color: #5E6AD2;">// company-profile-2026</div>
        <h1 class="text-6xl md:text-8xl font-medium tracking-tight mb-8">{brand.name}</h1>
        <p class="text-2xl mb-12" style="color: #B4BCD0;">
          <span data-lang="en">{brand.tagline.en}</span>
          <span data-lang="id">{brand.tagline.id}</span>
        </p>
      </div>
    </section>

    <!-- Part 1: Who we are & Who we serve -->
    <section class="py-24 border-b border-[#1F2125]">
      <div class="container-x grid lg:grid-cols-[1fr_2fr] gap-16">
        <div>
          <div class="font-mono text-xs uppercase tracking-[0.3em] mb-3" style="color: #5E6AD2;">01 / IDENT</div>
          <h2 class="text-3xl font-medium">
            <span data-lang="en">{profile.whoWeAre.title.en}</span>
            <span data-lang="id">{profile.whoWeAre.title.id}</span>
          </h2>
        </div>
        <div class="space-y-6">
          {profile.whoWeAre.body.en.map((p, i) => (
            <p class="text-lg leading-relaxed" style="color: #B4BCD0;">
              <span data-lang="en">{p}</span>
              <span data-lang="id">{profile.whoWeAre.body.id[i]}</span>
            </p>
          ))}
          <div class="pt-8 mt-8 border-t border-[#1F2125]">
            <h3 class="text-xl font-medium mb-4">
              <span data-lang="en">{profile.whoWeServe.title.en}</span>
              <span data-lang="id">{profile.whoWeServe.title.id}</span>
            </h3>
            <p class="text-lg leading-relaxed" style="color: #B4BCD0;">
              <span data-lang="en">{profile.whoWeServe.body.en}</span>
              <span data-lang="id">{profile.whoWeServe.body.id}</span>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Part 2: The Gap -->
    <section class="py-24 border-b border-[#1F2125]">
      <div class="container-x grid lg:grid-cols-[1fr_2fr] gap-16">
        <div>
          <div class="font-mono text-xs uppercase tracking-[0.3em] mb-3" style="color: #5E6AD2;">02 / PROBLEM</div>
          <h2 class="text-3xl font-medium">
            <span data-lang="en">{profile.theGap.title.en}</span>
            <span data-lang="id">{profile.theGap.title.id}</span>
          </h2>
        </div>
        <div class="space-y-6">
          {profile.theGap.body.en.map((p, i) => (
            <p class="text-lg leading-relaxed" style="color: #B4BCD0;">
              <span data-lang="en">{p}</span>
              <span data-lang="id">{profile.theGap.body.id[i]}</span>
            </p>
          ))}
        </div>
      </div>
    </section>

    <!-- Part 3: Approach -->
    <section class="py-24 border-b border-[#1F2125]">
      <div class="container-x">
        <div class="font-mono text-xs uppercase tracking-[0.3em] mb-3" style="color: #5E6AD2;">03 / SYSTEM</div>
        <h2 class="text-3xl font-medium mb-12">
          <span data-lang="en" set:html={kicker.approachTitle.en}></span>
          <span data-lang="id" set:html={kicker.approachTitle.id}></span>
        </h2>
        <div class="grid md:grid-cols-3 gap-px" style="background: #1F2125;">
          {stages.map(s => (
            <div class="p-8" style="background: #0E1011;">
              <div class="font-mono text-sm mb-3" style="color: #5E6AD2;">v0.{s.num}</div>
              <h3 class="text-xl font-medium mb-4"><span data-lang="en">{s.title.en}</span><span data-lang="id">{s.title.id}</span></h3>
              <p class="text-sm leading-relaxed" style="color: #B4BCD0;"><span data-lang="en">{s.body.en}</span><span data-lang="id">{s.body.id}</span></p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Part 4: Services -->
    <section class="py-24 border-b border-[#1F2125]">
      <div class="container-x">
        <div class="font-mono text-xs uppercase tracking-[0.3em] mb-12" style="color: #5E6AD2;">04 / MODULES</div>
        <div class="space-y-px" style="background: #1F2125;">
          {services.map(svc => (
            <div class="p-8 lg:p-12 grid lg:grid-cols-[1fr_2fr] gap-8" style="background: #08090A;">
              <div>
                <div class="font-mono text-sm mb-3" style="color: #5E6AD2;">MOD-{svc.num}</div>
                <h3 class="text-2xl font-medium">
                  <span data-lang="en">{svc.title.en}</span>
                  <span data-lang="id">{svc.title.id}</span>
                </h3>
              </div>
              <div class="space-y-4">
                {svc.detail.en.map((p, j) => (
                  <p class="text-base leading-relaxed" style="color: #B4BCD0;">
                    <span data-lang="en">{p}</span>
                    <span data-lang="id">{svc.detail.id[j]}</span>
                  </p>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Part 5: Impact / Proof -->
    <section class="py-24 border-b border-[#1F2125]">
      <div class="container-x">
        <div class="font-mono text-xs uppercase tracking-[0.3em] mb-12" style="color: #5E6AD2;">05 / TELEMETRY</div>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {impactCards.map(c => (
            <div class="border border-[#1F2125] p-6 rounded bg-[#0E1011]">
              <div class="text-xs font-mono text-[#5E6AD2] mb-3"><span data-lang="en">{c.tag.en}</span><span data-lang="id">{c.tag.id}</span></div>
              <h3 class="text-lg font-medium mb-3"><span data-lang="en">{c.title.en}</span><span data-lang="id">{c.title.id}</span></h3>
              <p class="text-sm leading-relaxed" style="color: #B4BCD0;"><span data-lang="en">{c.body.en}</span><span data-lang="id">{c.body.id}</span></p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Part 6: Team -->
    <section class="py-24 border-b border-[#1F2125]">
      <div class="container-x">
        <div class="font-mono text-xs uppercase tracking-[0.3em] mb-12" style="color: #5E6AD2;">06 / NODES</div>
        <div class="grid md:grid-cols-2 gap-12">
          {team.map(m => (
            <div class="flex gap-6">
              <div class="w-16 h-16 rounded flex items-center justify-center font-mono text-2xl shrink-0" style="background: #16181C; color: #5E6AD2;">{m.initials}</div>
              <div>
                <h3 class="font-medium text-xl">{m.name}</h3>
                <div class="text-xs font-mono mb-3 uppercase tracking-wider text-[#5E6AD2]">
                  <span data-lang="en">{m.role.en}</span>
                  <span data-lang="id">{m.role.id}</span>
                </div>
                <p class="text-sm leading-relaxed" style="color: #B4BCD0;">
                  <span data-lang="en">{m.bioFull.en}</span>
                  <span data-lang="id">{m.bioFull.id}</span>
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Closing -->
    <section class="py-32">
      <div class="container-x max-w-3xl">
        <div class="font-mono text-xs uppercase tracking-[0.3em] mb-6" style="color: #5E6AD2;">// init_sequence</div>
        <h2 class="text-4xl font-medium mb-8">
          <span data-lang="en">{profile.whatComesNext.title.en}</span>
          <span data-lang="id">{profile.whatComesNext.title.id}</span>
        </h2>
        <div class="space-y-4 mb-12">
          {profile.whatComesNext.body.en.map((p, i) => (
            <p class="text-lg" style="color: #B4BCD0;">
              <span data-lang="en">{p}</span>
              <span data-lang="id">{profile.whatComesNext.body.id[i]}</span>
            </p>
          ))}
        </div>
        <a href={`mailto:${brand.email}`} class="inline-block px-8 py-4 rounded-lg font-medium font-mono text-sm" style="background: #5E6AD2; color: white;">&gt; contact_us</a>
      </div>
    </section>
  </div>
</ProfileLayout>