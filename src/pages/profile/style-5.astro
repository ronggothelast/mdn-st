---
// STYLE 05 — Apple Premium
import ProfileLayout from '../../layouts/ProfileLayout.astro';
import { brand, profile, services, team, stages, impactCards, kicker } from '../../data/content';
const base = import.meta.env.BASE_URL;
---
<ProfileLayout styleNum={5} styleName="Apple Premium">
  <div style="background: #FBFBFD; color: #1D1D1F; font-family: 'Inter', -apple-system, sans-serif; -webkit-font-smoothing: antialiased;">
    <!-- Hero -->
    <section class="min-h-screen flex items-center pt-32 pb-24" style="background: linear-gradient(180deg, #fafafa 0%, #ffffff 100%);">
      <div class="container-x text-center max-w-5xl">
        <h1 class="text-[clamp(4rem,12vw,11rem)] font-semibold leading-[0.95] tracking-[-0.04em] mb-8">{brand.name}</h1>
        <p class="text-2xl md:text-4xl font-medium tracking-tight" style="color: #6E6E73;">
          <span data-lang="en">{brand.tagline.en}</span>
          <span data-lang="id">{brand.tagline.id}</span>
        </p>
      </div>
    </section>

    <!-- 1. Who we are -->
    <section class="py-32">
      <div class="container-x max-w-4xl text-center">
        <h2 class="text-4xl md:text-6xl font-semibold tracking-tight leading-tight mb-12">
          <span data-lang="en">{profile.whoWeAre.title.en}</span>
          <span data-lang="id">{profile.whoWeAre.title.id}</span>
        </h2>
        <div class="text-left space-y-6">
          {profile.whoWeAre.body.en.map((p, i) => (
            <p class="text-2xl leading-relaxed font-medium" style="color: #6E6E73;">
              <span data-lang="en">{p}</span>
              <span data-lang="id">{profile.whoWeAre.body.id[i]}</span>
            </p>
          ))}
        </div>
      </div>
    </section>

    <!-- 2. Who we serve & 3. The Gap -->
    <section class="py-32" style="background: #f5f5f7;">
      <div class="container-x max-w-4xl space-y-24">
        <div>
          <h2 class="text-4xl font-semibold tracking-tight mb-8">
            <span data-lang="en">{profile.whoWeServe.title.en}</span>
            <span data-lang="id">{profile.whoWeServe.title.id}</span>
          </h2>
          <p class="text-2xl leading-relaxed font-medium" style="color: #6E6E73;">
            <span data-lang="en">{profile.whoWeServe.body.en}</span>
            <span data-lang="id">{profile.whoWeServe.body.id}</span>
          </p>
        </div>
        <div>
          <h2 class="text-4xl font-semibold tracking-tight mb-8">
            <span data-lang="en">{profile.theGap.title.en}</span>
            <span data-lang="id">{profile.theGap.title.id}</span>
          </h2>
          <div class="space-y-6">
            {profile.theGap.body.en.map((p, i) => (
              <p class="text-2xl leading-relaxed font-medium" style="color: #6E6E73;">
                <span data-lang="en">{p}</span>
                <span data-lang="id">{profile.theGap.body.id[i]}</span>
              </p>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Approach -->
    <section class="py-32" style="background: #000; color: white;">
      <div class="container-x max-w-5xl">
        <h2 class="text-5xl md:text-7xl font-semibold tracking-tight mb-16 text-center">
          <span data-lang="en" set:html={kicker.approachTitle.en}></span>
          <span data-lang="id" set:html={kicker.approachTitle.id}></span>
        </h2>
        <div class="grid md:grid-cols-3 gap-8">
          {stages.map(s => (
            <div class="p-8 rounded-3xl" style="background: #1d1d1f;">
              <div class="text-white/50 font-semibold mb-4">Step {s.num}</div>
              <h3 class="text-2xl font-semibold mb-4"><span data-lang="en">{s.title.en}</span><span data-lang="id">{s.title.id}</span></h3>
              <p class="text-lg text-white/70"><span data-lang="en">{s.body.en}</span><span data-lang="id">{s.body.id}</span></p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 5. Services -->
    <section class="py-32 space-y-8 px-6">
      <h2 class="text-5xl font-semibold tracking-tight text-center mb-16">
        <span data-lang="en">Services.</span>
        <span data-lang="id">Layanan.</span>
      </h2>
      {services.map(svc => (
        <div class="rounded-3xl py-24 px-12 max-w-7xl mx-auto" style="background: #f5f5f7;">
          <div class="text-sm font-medium uppercase tracking-widest mb-4" style="color: #6E6E73;">{svc.num}</div>
          <h3 class="text-5xl md:text-6xl font-semibold tracking-tight mb-12 max-w-3xl">
            <span data-lang="en">{svc.title.en}</span>
            <span data-lang="id">{svc.title.id}</span>
          </h3>
          <div class="space-y-6 max-w-4xl">
            {svc.detail.en.map((p, j) => (
              <p class="text-2xl font-medium" style="color: #6E6E73;">
                <span data-lang="en">{p}</span>
                <span data-lang="id">{svc.detail.id[j]}</span>
              </p>
            ))}
          </div>
        </div>
      ))}
    </section>

    <!-- 6. Impact -->
    <section class="py-32">
      <div class="container-x max-w-6xl">
        <h2 class="text-5xl font-semibold tracking-tight text-center mb-16">
          <span data-lang="en">Impact.</span>
          <span data-lang="id">Dampak.</span>
        </h2>
        <div class="grid md:grid-cols-2 gap-8">
          {impactCards.map(c => (
            <div class="p-10 rounded-3xl" style="background: #f5f5f7;">
              <h3 class="text-2xl font-semibold mb-4"><span data-lang="en">{c.title.en}</span><span data-lang="id">{c.title.id}</span></h3>
              <p class="text-xl" style="color: #6E6E73;"><span data-lang="en">{c.body.en}</span><span data-lang="id">{c.body.id}</span></p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 7. Team -->
    <section class="py-32" style="background: #f5f5f7;">
      <div class="container-x max-w-6xl">
        <h2 class="text-5xl md:text-6xl font-semibold tracking-tight mb-16 text-center">
          <span data-lang="en">The team.</span>
          <span data-lang="id">Tim.</span>
        </h2>
        <div class="grid md:grid-cols-2 gap-12">
          {team.map(m => (
            <div class="bg-white p-10 rounded-3xl">
              <div class="w-20 h-20 rounded-full mb-6 flex items-center justify-center font-semibold text-3xl text-white" style="background: linear-gradient(135deg, #1A2E4A, #3D8F8A);">{m.initials}</div>
              <h3 class="text-3xl font-semibold mb-2">{m.name}</h3>
              <div class="text-lg font-medium mb-6" style="color: #6E6E73;">
                <span data-lang="en">{m.role.en}</span>
                <span data-lang="id">{m.role.id}</span>
              </div>
              <p class="text-xl leading-relaxed" style="color: #6E6E73;">
                <span data-lang="en">{m.bioFull.en}</span>
                <span data-lang="id">{m.bioFull.id}</span>
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 8. Closing -->
    <section class="py-32 text-center">
      <div class="container-x max-w-4xl">
        <h2 class="text-5xl md:text-7xl font-semibold tracking-tight mb-12">
          <span data-lang="en">{profile.whatComesNext.title.en}</span>
          <span data-lang="id">{profile.whatComesNext.title.id}</span>
        </h2>
        <div class="space-y-6 mb-16 text-left">
          {profile.whatComesNext.body.en.map((p, i) => (
            <p class="text-2xl font-medium" style="color: #6E6E73;">
              <span data-lang="en">{p}</span>
              <span data-lang="id">{profile.whatComesNext.body.id[i]}</span>
            </p>
          ))}
        </div>
        <a href={`mailto:${brand.email}`} class="inline-block px-12 py-5 rounded-full text-2xl font-semibold text-white transition-opacity hover:opacity-90" style="background: #0071e3;">{brand.email}</a>
      </div>
    </section>
  </div>
</ProfileLayout>