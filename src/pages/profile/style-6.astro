---
// STYLE 06 — BMW Engineering
import ProfileLayout from '../../layouts/ProfileLayout.astro';
import { brand, profile, services, team, stages, impactCards, kicker } from '../../data/content';
const base = import.meta.env.BASE_URL;
---
<ProfileLayout styleNum={6} styleName="BMW Engineering">
  <div style="background: #000; color: #fff; font-family: 'Inter', sans-serif;">
    <!-- M-stripe -->
    <div class="h-1 flex">
      <div class="flex-1" style="background: #1c69d4;"></div>
      <div class="flex-1" style="background: #2D2D2D;"></div>
      <div class="flex-1" style="background: #d40015;"></div>
    </div>

    <!-- 0. Hero -->
    <section class="py-32 relative overflow-hidden">
      <div class="absolute inset-0 opacity-20">
        <img src={base + '/assets/images/forest.png'} alt="" class="w-full h-full object-cover" />
      </div>
      <div class="absolute inset-0" style="background: linear-gradient(180deg, transparent 0%, #000 90%);"></div>
      <div class="container-x relative">
        <div class="text-xs font-mono uppercase tracking-[0.4em] text-white/60 mb-6">⌬ ENGINEERED FOR IMPACT</div>
        <h1 class="text-7xl md:text-9xl font-light leading-[0.95] tracking-tight mb-8 uppercase">{brand.name}</h1>
        <p class="text-2xl text-white/80 max-w-2xl uppercase tracking-wide">
          <span data-lang="en">{brand.tagline.en}</span>
          <span data-lang="id">{brand.tagline.id}</span>
        </p>
      </div>
    </section>

    <!-- 1. Who We Are & 2. Who We Serve -->
    <section class="py-24 border-t border-white/10">
      <div class="container-x grid lg:grid-cols-[1fr_2fr] gap-12">
        <div>
          <div class="text-xs font-mono uppercase tracking-[0.3em] text-white/60 mb-4">/ SECTION 01</div>
          <h2 class="text-3xl uppercase tracking-tight">
            <span data-lang="en">{profile.whoWeAre.title.en}</span>
            <span data-lang="id">{profile.whoWeAre.title.id}</span>
          </h2>
          <div class="h-1 w-16 mt-6" style="background: linear-gradient(90deg, #1c69d4, #d40015);"></div>
        </div>
        <div class="space-y-12">
          <div>
            {profile.whoWeAre.body.en.map((p, i) => (
              <p class="text-lg leading-relaxed mb-6 text-white/80">
                <span data-lang="en">{p}</span>
                <span data-lang="id">{profile.whoWeAre.body.id[i]}</span>
              </p>
            ))}
          </div>
          <div class="p-8 border border-white/10" style="background: rgba(255,255,255,0.05);">
            <h3 class="text-xl uppercase tracking-wide mb-4 text-[#1c69d4]">
              <span data-lang="en">{profile.whoWeServe.title.en}</span>
              <span data-lang="id">{profile.whoWeServe.title.id}</span>
            </h3>
            <p class="text-white/80 leading-relaxed">
              <span data-lang="en">{profile.whoWeServe.body.en}</span>
              <span data-lang="id">{profile.whoWeServe.body.id}</span>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. The Gap -->
    <section class="py-24 border-t border-white/10">
      <div class="container-x grid lg:grid-cols-[1fr_2fr] gap-12">
        <div>
          <div class="text-xs font-mono uppercase tracking-[0.3em] text-white/60 mb-4">/ SECTION 02</div>
          <h2 class="text-3xl uppercase tracking-tight">
            <span data-lang="en">{profile.theGap.title.en}</span>
            <span data-lang="id">{profile.theGap.title.id}</span>
          </h2>
        </div>
        <div>
          {profile.theGap.body.en.map((p, i) => (
            <p class="text-lg leading-relaxed mb-6 text-white/80">
              <span data-lang="en">{p}</span>
              <span data-lang="id">{profile.theGap.body.id[i]}</span>
            </p>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. Approach -->
    <section class="py-24 border-t border-white/10">
      <div class="container-x">
        <div class="text-xs font-mono uppercase tracking-[0.3em] text-white/60 mb-4">/ SECTION 03 · METHODOLOGY</div>
        <h2 class="text-4xl uppercase tracking-tight mb-16">
          <span data-lang="en" set:html={kicker.approachTitle.en}></span>
          <span data-lang="id" set:html={kicker.approachTitle.id}></span>
        </h2>
        <div class="grid md:grid-cols-3 gap-px" style="background: rgba(255,255,255,0.1);">
          {stages.map(s => (
            <div class="p-10" style="background: #0a0a0a;">
              <div class="text-xs font-mono mb-4 text-[#d40015]">PHASE 0{s.num} //</div>
              <h3 class="text-2xl uppercase tracking-wide mb-4">
                <span data-lang="en">{s.title.en}</span>
                <span data-lang="id">{s.title.id}</span>
              </h3>
              <p class="text-white/70 leading-relaxed">
                <span data-lang="en">{s.body.en}</span>
                <span data-lang="id">{s.body.id}</span>
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 5. Services -->
    <section class="py-24 border-t border-white/10">
      <div class="container-x">
        <div class="text-xs font-mono uppercase tracking-[0.3em] text-white/60 mb-4">/ SECTION 04 · CAPABILITIES</div>
        <h2 class="text-4xl uppercase tracking-tight mb-16">
          <span data-lang="en">Three engineering disciplines</span>
          <span data-lang="id">Tiga disiplin rekayasa</span>
        </h2>
        <div class="space-y-px" style="background: rgba(255,255,255,0.1);">
          {services.map(svc => (
            <div class="p-10 lg:p-16 grid lg:grid-cols-[1fr_2fr] gap-8" style="background: #0a0a0a;">
              <div>
                <div class="text-5xl font-light mb-4" style="color: #1c69d4;">{svc.num}</div>
                <h3 class="text-2xl uppercase tracking-wide">
                  <span data-lang="en">{svc.title.en}</span>
                  <span data-lang="id">{svc.title.id}</span>
                </h3>
              </div>
              <div class="space-y-4">
                {svc.detail.en.map((p, j) => (
                  <p class="text-white/80 leading-relaxed text-lg">
                    <span data-lang="en">{p}</span>
                    <span data-lang="id">{svc.detail.id[j]}</span>
                  </p>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. Impact -->
    <section class="py-24 border-t border-white/10">
      <div class="container-x">
        <div class="text-xs font-mono uppercase tracking-[0.3em] text-white/60 mb-4">/ SECTION 05 · METRICS</div>
        <div class="grid md:grid-cols-2 gap-8">
          {impactCards.map(c => (
            <div class="border border-white/10 p-8">
              <div class="text-xs font-mono uppercase tracking-wider mb-4" style="color: #d40015;">[{c.tag.en}]</div>
              <h3 class="text-xl uppercase tracking-wide mb-3"><span data-lang="en">{c.title.en}</span><span data-lang="id">{c.title.id}</span></h3>
              <p class="text-white/70 leading-relaxed"><span data-lang="en">{c.body.en}</span><span data-lang="id">{c.body.id}</span></p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 7. Team -->
    <section class="py-24 border-t border-white/10">
      <div class="container-x">
        <div class="text-xs font-mono uppercase tracking-[0.3em] text-white/60 mb-4">/ SECTION 06 · TEAM</div>
        <h2 class="text-4xl uppercase tracking-tight mb-16">
          <span data-lang="en">Engineers behind the work</span>
          <span data-lang="id">Insinyur di balik karya</span>
        </h2>
        <div class="grid md:grid-cols-2 gap-12">
          {team.map(m => (
            <div class="border-l-2 border-[#1c69d4] pl-8">
              <div class="w-16 h-16 mb-6 flex items-center justify-center font-light text-2xl" style="background: linear-gradient(135deg, #1c69d4, #000); color: white;">{m.initials}</div>
              <h3 class="text-2xl uppercase tracking-wide mb-1">{m.name}</h3>
              <div class="text-sm font-mono uppercase tracking-wider mb-4" style="color: #1c69d4;">
                <span data-lang="en">{m.role.en}</span>
                <span data-lang="id">{m.role.id}</span>
              </div>
              <p class="text-base text-white/70 leading-relaxed">
                <span data-lang="en">{m.bioFull.en}</span>
                <span data-lang="id">{m.bioFull.id}</span>
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 8. Closing -->
    <section class="py-32 border-t border-white/10 text-center">
      <div class="container-x max-w-4xl">
        <h2 class="text-5xl uppercase tracking-tight mb-12">
          <span data-lang="en">{profile.whatComesNext.title.en}</span>
          <span data-lang="id">{profile.whatComesNext.title.id}</span>
        </h2>
        <div class="space-y-6 mb-12 text-left">
          {profile.whatComesNext.body.en.map((p, i) => (
            <p class="text-xl text-white/80 leading-relaxed">
              <span data-lang="en">{p}</span>
              <span data-lang="id">{profile.whatComesNext.body.id[i]}</span>
            </p>
          ))}
        </div>
        <a href={`mailto:${brand.email}`} class="inline-block px-12 py-4 font-medium tracking-wider uppercase text-sm" style="background: #1c69d4; color: white;">&gt; INITIATE CONTACT</a>
      </div>
    </section>

    <div class="h-1 flex">
      <div class="flex-1" style="background: #1c69d4;"></div>
      <div class="flex-1" style="background: #2D2D2D;"></div>
      <div class="flex-1" style="background: #d40015;"></div>
    </div>
  </div>
</ProfileLayout>
