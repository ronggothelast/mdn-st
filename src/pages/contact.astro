---
import BaseLayout from '../layouts/BaseLayout.astro';
import { brand, contact as contactCopy, finalCta } from '../data/content';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Contact">
  <!-- INTRO -->
  <section class="py-24" style="background: linear-gradient(180deg, #FAF6EC, #ffffff);">
    <div class="container-x max-w-4xl text-center">
      <h1 class="text-5xl md:text-6xl mb-8 leading-tight" style="font-family: 'Fraunces', Georgia, serif;">
        <span data-lang="en">{contactCopy.headline.en}</span>
        <span data-lang="id">{contactCopy.headline.id}</span>
      </h1>
      <p class="text-lg leading-[1.7] max-w-2xl mx-auto" style="color: #4A5568;">
        <span data-lang="en">{contactCopy.body.en}</span>
        <span data-lang="id">{contactCopy.body.id}</span>
      </p>
    </div>
  </section>

  <!-- DETAILS -->
  <section class="py-20 bg-white">
    <div class="container-x max-w-5xl grid md:grid-cols-2 gap-12">
      <div>
        <h2 class="text-2xl mb-8" style="font-family: 'Fraunces', Georgia, serif;">
          <span data-lang="en">Contact Details</span><span data-lang="id">Kontak</span>
        </h2>
        <div class="space-y-6">
          <div>
            <div class="text-xs font-sans uppercase tracking-[0.3em] mb-2" style="color: #3D8F8A;">
              <span data-lang="en">Email</span><span data-lang="id">Email</span>
            </div>
            <a href={`mailto:${brand.email}`} class="text-xl">{brand.email}</a>
          </div>
          <div>
            <div class="text-xs font-sans uppercase tracking-[0.3em] mb-2" style="color: #3D8F8A;">
              <span data-lang="en">Phone</span><span data-lang="id">Telepon</span>
            </div>
            <a href={`tel:${brand.phone.replace(/[^+\d]/g, '')}`} class="text-xl">{brand.phone}</a>
          </div>
          <div>
            <div class="text-xs font-sans uppercase tracking-[0.3em] mb-2" style="color: #3D8F8A;">
              <span data-lang="en">Address</span><span data-lang="id">Alamat</span>
            </div>
            <p class="leading-[1.7]" style="color: #4A5568;">
              <span data-lang="en">{brand.address.en}</span>
              <span data-lang="id">{brand.address.id}</span>
            </p>
          </div>
          <div>
            <div class="text-xs font-sans uppercase tracking-[0.3em] mb-2" style="color: #3D8F8A;">
              <span data-lang="en">Web</span><span data-lang="id">Web</span>
            </div>
            <p class="text-xl">{brand.web}</p>
          </div>
        </div>
      </div>

      <div class="rounded-3xl p-8 border" style="border-color: rgba(26,46,74,0.12); background: #FAF6EC;">
        <h2 class="text-2xl mb-6" style="font-family: 'Fraunces', Georgia, serif;">
          <span data-lang="en">Send Us a Message</span><span data-lang="id">Kirim Pesan</span>
        </h2>
        <form class="space-y-4" onsubmit="window.location.href = `mailto:${'hello@madanistrategies.com'}?subject=${encodeURIComponent(this.subject.value)}&body=${encodeURIComponent(this.message.value)}&from=${encodeURIComponent(this.email.value)}`; return false;">
          <input name="name" required placeholder="Your name" class="w-full px-4 py-3 rounded-lg border bg-white" style="border-color: rgba(26,46,74,0.15);" />
          <input name="email" type="email" required placeholder="your@email.com" class="w-full px-4 py-3 rounded-lg border bg-white" style="border-color: rgba(26,46,74,0.15);" />
          <input name="subject" placeholder="Subject" class="w-full px-4 py-3 rounded-lg border bg-white" style="border-color: rgba(26,46,74,0.15);" />
          <textarea name="message" required rows="5" placeholder="Tell us what you're facing..." class="w-full px-4 py-3 rounded-lg border bg-white" style="border-color: rgba(26,46,74,0.15);"></textarea>
          <button type="submit" class="w-full px-6 py-3 rounded-full font-medium text-sm" style="background: #1A2E4A; color: white;">
            <span data-lang="en">Send Message</span><span data-lang="id">Kirim Pesan</span>
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
